@inject SignInManager<Users> SignInManager

<ul class="nav nav-pills flex-column manage-nav">
    <li class="nav-item">
        <a class="nav-link @ManageNavPages.IndexNavClass(ViewContext)" id="profile" asp-page="./Index">
            <i class="fas fa-id-card me-2"></i> Profile
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @ManageNavPages.ChangePasswordNavClass(ViewContext)" id="change-password" asp-page="./ChangePassword">
            <i class="fas fa-key me-2"></i> Password
        </a>
    </li>
</ul>

<style>
    .manage-nav .nav-link {
        color: #1e1e2f;
        border-radius: 8px;
        padding: 10px 14px;
        font-weight: 500;
        transition: all 0.2s ease;
    }

    .manage-nav .nav-link:hover {
        background: rgba(196, 37, 42, 0.08);
        color: #c4252a;
    }

    .manage-nav .nav-link.active {
        background: #c4252a;
        color: #fff;
    }
</style>
