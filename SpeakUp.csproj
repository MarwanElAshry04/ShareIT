<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ShareIT</RootNamespace>
    <AssemblyName>ShareIT</AssemblyName>
    <UserSecretsId>aspnet-ShareIT-a6758561-723f-4a9d-a2bf-2d973b40af1e</UserSecretsId>
