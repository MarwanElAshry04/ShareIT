# Normalize line endings: store text as LF in the repo, check out native on each OS.
* text=auto

# Explicit text files
*.cs        text diff=csharp
*.cshtml    text
*.csproj    text
*.sln       text eol=crlf
*.json      text
*.js        text
*.css       text
*.html      text
*.md        text
*.config    text

# Binary assets (never normalize)
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.webm      binary
*.woff      binary
*.woff2     binary
*.ttf       binary
