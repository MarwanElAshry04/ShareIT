# Build output
[Bb]in/
[Oo]bj/
[Oo]ut/

# Visual Studio / Rider / VS Code
.vs/
.vscode/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates

# ASP.NET scaffolding / publish
[Pp]ublish/
*.pubxml.user
PublishScripts/

# User-specific secrets (SMTP password etc. live here, NOT in the repo)
# (dotnet user-secrets are stored outside the project by design)
appsettings.*.local.json
secrets.json

# Runtime-generated uploads / user content (regenerated by the app on demand)
wwwroot/uploads/
wwwroot/CompFiles/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Local Claude Code settings (machine-specific)
.claude/settings.local.json

# Runtime scratch from the upload wizard (never source)
wwwroot/TempUploads/
