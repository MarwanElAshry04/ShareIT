@model ShareIT.Models.ViewModel.TicketSearchModel
@{
    ViewData["Title"] = "Search Ticket - ELSEWEDY ELECTRIC";
}

<style>
    :root {
        --primary-red: #c4252a;
        --primary-black: #302e2d;
        --light-gray: #f8f9fa;
        --dark-gray: #343a40;
    }

    .search-card {
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        overflow: hidden;
    }

    .search-header {
        background: #f8f9fa;
        color: black;
        padding: 25px;
        border-bottom: 4px solid var(--primary-red);
    }

    .search-icon {
        width: 60px;
        height: 60px;
        background: linear-gradient(135deg, var(--primary-red), #ff6b6b);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 24px;
        margin: 0 auto 20px;
        box-shadow: 0 5px 15px rgba(196, 37, 42, 0.3);
    }

    .form-control-custom {
        border: 2px solid #e9ecef;
        border-radius: 10px;
        padding: 15px;
        font-size: 16px;
        transition: all 0.3s;
        background: white;
    }

        .form-control-custom:focus {
            border-color: var(--primary-red);
            box-shadow: 0 0 0 0.25rem rgba(196, 37, 42, 0.25);
            transform: translateY(-2px);
        }

    .input-group-custom {
        position: relative;
    }

    .input-icon {
        position: absolute;
        left: 15px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--primary-red);
        z-index: 3;
    }

    .input-with-icon {
        padding-inline-start: 45px;
    }

    .btn-search {
        background: linear-gradient(135deg, var(--primary-red), #e02020);
        border: none;
        border-radius: 10px;
        padding: 15px 30px;
        font-weight: 600;
        font-size: 16px;
        transition: all 0.3s;
        color: white;
        width: 100%;
        position: relative;
        overflow: hidden;
    }

        .btn-search:hover {
            background: linear-gradient(135deg, #e02020, var(--primary-red));
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(196, 37, 42, 0.3);
        }

        .btn-search:active {
            transform: translateY(-1px);
        }

        .btn-search:disabled {
            background: #6c757d;
            transform: none;
            box-shadow: none;
        }

    .alert-custom {
        border-radius: 10px;
        border-inline-start: 4px solid;
        padding: 15px;
        margin-bottom: 20px;
    }

    .alert-success-custom {
        background: linear-gradient(to right, #d4edda, #f0f9f2);
        border-left-color: #28a745;
        color: #155724;
    }

    .alert-danger-custom {
        background: linear-gradient(to right, #f8d7da, #fdf2f3);
        border-left-color: #dc3545;
        color: #721c24;
    }

    .alert-warning-custom {
        background: linear-gradient(to right, #fff3cd, #fffdf6);
        border-left-color: #ffc107;
        color: #856404;
    }

    .alert-info-custom {
        background: linear-gradient(to right, #d1ecf1, #f2f9fa);
        border-left-color: #17a2b8;
        color: #0c5460;
    }

    .forgot-password-link {
        color: var(--primary-red);
        text-decoration: none;
        font-weight: 500;
        transition: all 0.3s;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

        .forgot-password-link:hover {
            color: #e02020;
            text-decoration: underline;
            transform: translateX(3px);
        }

    /* Ticket Details Card */
    .ticket-details-card {
        border-radius: 12px;
        overflow: hidden;
    }

    .card-header.bg-dark {
        background: linear-gradient(135deg, var(--primary-black), #000) !important;
        border-bottom: 4px solid var(--primary-red);
    }

    .header-icon {
        width: 50px;
        height: 50px;
        background: var(--primary-red);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        color: white;
    }

    .case-reference-banner {
        background: linear-gradient(to right, #f8f9fa, #e9ecef);
        padding: 20px;
        border-bottom: 1px solid #dee2e6;
    }

    .reference-number {
        font-size: 2.2rem;
        font-weight: 800;
        color: var(--primary-black);
        margin: 0;
        background: linear-gradient(135deg, var(--primary-red), #ff6b6b);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .case-info-box {
        display: inline-flex;
        gap: 20px;
        background: white;
        padding: 10px 20px;
        border-radius: 8px;
        border: 1px solid #dee2e6;
    }

    .case-info-item {
        text-align: center;
    }

        .case-info-item .label {
            display: block;
            font-size: 12px;
            color: #6c757d;
            margin-bottom: 4px;
        }

        .case-info-item .value {
            display: block;
            font-weight: 700;
            color: var(--primary-black);
        }

    .priority-medium {
        color: #fd7e14;
        font-weight: 600;
    }

    /* Status Badges */
    .status-badge-large {
        padding: 12px 25px;
        border-radius: 25px;
        font-weight: 700;
        font-size: 16px;
        display: inline-block;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .badge-open {
        background: linear-gradient(135deg, #28a745, #20c997);
        color: white;
    }

    .badge-investigation {
        background: linear-gradient(135deg, #007bff, #0056b3);
        color: white;
    }

    .badge-pending {
        background: linear-gradient(135deg, #ffc107, #fd7e14);
        color: white;
    }

    .badge-resolved {
        background: linear-gradient(135deg, #6c757d, #495057);
        color: white;
    }

    .badge-closed {
        background: linear-gradient(135deg, #343a40, #000);
        color: white;
    }

    /* Detail Cards */
    .detail-card {
        background: white;
        border: 1px solid #e9ecef;
        border-radius: 10px;
        overflow: hidden;
        height: 100%;
        transition: all 0.3s ease;
    }

        .detail-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.1);
        }

    .detail-card-header {
        background: #f8f9fa;
        padding: 15px 20px;
        border-bottom: 2px solid var(--primary-red);
        font-weight: 600;
        color: var(--primary-black);
        font-size: 16px;
    }

    .detail-card-body {
        padding: 20px;
    }

    .detail-row {
        display: flex;
        align-items: center;
        padding: 12px 0;
        border-bottom: 1px solid #f8f9fa;
    }

        .detail-row:last-child {
            border-bottom: none;
        }

    .detail-label {
        flex: 0 0 160px;
        font-weight: 500;
        color: #495057;
        font-size: 14px;
    }

    .detail-value {
        flex: 1;
        font-weight: 500;
        color: var(--primary-black);
    }

    .language-badge {
        padding: 4px 12px;
        border-radius: 15px;
        font-size: 13px;
        font-weight: 500;
    }

        .language-badge.english {
            background: #d1ecf1;
            color: #0c5460;
        }

        .language-badge.arabic {
            background: #d4edda;
            color: #155724;
        }

    /* Description Box */
    .ticket-description {
        line-height: 1.8;
        color: #343a40;
        font-size: 15px;
        max-height: 300px;
        overflow-y: auto;
        padding: 15px;
        background: #f8f9fa;
        border-radius: 8px;
        border: 1px solid #e9ecef;
    }

    /* Timeline */
    .timeline-vertical {
        position: relative;
        padding-inline-start: 30px;
    }

        .timeline-vertical::before {
            content: '';
            position: absolute;
            left: 15px;
            top: 0;
            bottom: 0;
            width: 2px;
            background: linear-gradient(to bottom, var(--primary-red), #6c757d);
        }

    .timeline-event {
        position: relative;
        margin-bottom: 25px;
        display: flex;
        align-items: flex-start;
    }

    .timeline-point {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        position: absolute;
        left: -38px;
        top: 0;
        font-size: 12px;
        border: 3px solid white;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

        .timeline-point.bg-success {
            background: #28a745;
        }

        .timeline-point.bg-primary {
            background: #007bff;
        }

        .timeline-point.bg-warning {
            background: #ffc107;
        }

        .timeline-point.bg-danger {
            background: #dc3545;
        }

        .timeline-point.bg-info {
            background: #17a2b8;
        }

        .timeline-point.bg-dark {
            background: #343a40;
        }

    .timeline-content {
        flex: 1;
        background: white;
        border: 1px solid #e9ecef;
        border-radius: 8px;
        padding: 15px;
    }

    .timeline-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
    }

    .timeline-date {
        color: #6c757d;
        font-size: 13px;
    }

    .timeline-desc {
        color: #495057;
        font-size: 14px;
        line-height: 1.5;
    }

    /* Updates List */
    .updates-list {
        max-height: 300px;
        overflow-y: auto;
    }

    .update-item {
        background: white;
        border: 1px solid #e9ecef;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 10px;
        transition: all 0.3s ease;
    }

        .update-item:hover {
            border-color: var(--primary-red);
            background: #fff5f5;
        }

    .update-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
    }

    .update-author {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .author-avatar {
        width: 30px;
        height: 30px;
        background: var(--primary-red);
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
    }

    .update-time {
        color: #6c757d;
        font-size: 12px;
    }

    .update-content {
        color: #343a40;
        font-size: 14px;
        line-height: 1.5;
        margin: 0;
    }

    /* Attachments Grid */
    .attachments-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 15px;
    }

    .attachment-card {
        display: flex;
        align-items: center;
        padding: 15px;
        background: #f8f9fa;
        border-radius: 8px;
        border: 1px solid #e9ecef;
        transition: all 0.3s ease;
    }

        .attachment-card:hover {
            background: white;
            border-color: var(--primary-red);
            transform: translateX(5px);
        }

    .attachment-icon {
        width: 40px;
        height: 40px;
        background: linear-gradient(135deg, var(--primary-red), #ff6b6b);
        color: white;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-inline-end: 15px;
        font-size: 18px;
    }

    .attachment-info {
        flex: 1;
        min-width: 0;
    }

    .attachment-name {
        font-weight: 500;
        color: var(--primary-black);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        font-size: 14px;
    }

    .attachment-meta {
        font-size: 12px;
        color: #6c757d;
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .attachment-download {
        width: 35px;
        height: 35px;
        border: 1px solid var(--primary-red);
        background: white;
        color: var(--primary-red);
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.3s;
    }

        .attachment-download:hover {
            background: var(--primary-red);
            color: white;
        }

    /* Empty States */
    .empty-state {
        text-align: center;
        padding: 40px 20px;
        color: #6c757d;
    }

        .empty-state i {
            opacity: 0.5;
        }

    /* Action Buttons */
    .action-buttons {
        display: flex;
        gap: 10px;
    }

    /* Chat Styles */
    .chat-container {
        display: flex;
        flex-direction: column;
        height: 400px;
    }

    .chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: 20px;
        background: #f8f9fa;
        border-radius: 10px 10px 0 0;
    }

    .chat-input-area {
        background: white;
        border-radius: 0 0 10px 10px;
    }

    .chat-input {
        resize: none;
        border: 2px solid #dee2e6;
        border-radius: 8px;
        padding: 10px 15px;
        font-size: 14px;
        transition: all 0.3s;
    }

        .chat-input:focus {
            border-color: var(--primary-red);
            box-shadow: 0 0 0 0.2rem rgba(196, 37, 42, 0.25);
        }

    /* Message Bubbles */
    .message-bubble {
        max-width: 80%;
        margin-bottom: 15px;
        position: relative;
        animation: fadeIn 0.3s ease-in-out;
    }

    .message-user {
        margin-inline-start: auto;
    }

    .message-compliance {
        margin-inline-end: auto;
    }

    .message-content {
        padding: 12px 16px;
        border-radius: 18px;
        position: relative;
        word-wrap: break-word;
    }

    .message-user .message-content {
        background: linear-gradient(135deg, var(--primary-red), #e02020);
        color: white;
        border-bottom-right-radius: 4px;
    }

    .message-compliance .message-content {
        background: white;
        color: var(--primary-black);
        border: 1px solid #dee2e6;
        border-bottom-left-radius: 4px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
    }

    .message-header {
        display: flex;
        justify-content: space-between;
        margin-bottom: 5px;
        font-size: 12px;
    }

    .message-sender {
        font-weight: 600;
    }

    .message-time {
        color: #6c757d;
    }

    .message-text {
        line-height: 1.5;
    }

    .message-attachment {
        margin-top: 10px;
        background: rgba(255,255,255,0.1);
        border-radius: 8px;
        padding: 8px;
    }

    .attachment-preview {
        display: flex;
        align-items: center;
        padding: 8px;
        background: white;
        border-radius: 6px;
        border: 1px solid #dee2e6;
        margin-top: 5px;
    }

    .attachment-icon-chat {
        width: 30px;
        height: 30px;
        background: var(--primary-red);
        color: white;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-inline-end: 10px;
    }

    .attachment-info-chat {
        flex: 1;
        min-width: 0;
    }

    .attachment-name-chat {
        font-size: 13px;
        font-weight: 500;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .attachment-download-chat {
        color: var(--primary-red);
        text-decoration: none;
    }

        .attachment-download-chat:hover {
            text-decoration: underline;
        }

    .typing-indicator {
        display: flex;
        align-items: center;
        padding: 10px 15px;
        background: white;
        border-radius: 18px;
        border: 1px solid #dee2e6;
        width: fit-content;
        margin-bottom: 15px;
    }

    .typing-dots {
        display: flex;
        gap: 4px;
    }

    .typing-dot {
        width: 6px;
        height: 6px;
        background: #6c757d;
        border-radius: 50%;
        animation: typing 1.4s infinite;
    }

        .typing-dot:nth-child(2) {
            animation-delay: 0.2s;
        }

        .typing-dot:nth-child(3) {
            animation-delay: 0.4s;
        }

    /* Chat Date Separator */
    .date-separator {
        text-align: center;
        margin: 20px 0;
        position: relative;
    }

        .date-separator::before {
            content: '';
            position: absolute;
            left: 0;
            right: 0;
            top: 50%;
            height: 1px;
            background: #dee2e6;
            z-index: 1;
        }

    .date-label {
        background: white;
        padding: 5px 15px;
        border-radius: 20px;
        border: 1px solid #dee2e6;
        color: #6c757d;
        font-size: 12px;
        font-weight: 500;
        position: relative;
        z-index: 2;
        display: inline-block;
    }

    /* Empty Chat State */
    .empty-chat {
        text-align: center;
        padding: 60px 20px;
    }

        .empty-chat i {
            font-size: 48px;
            color: #dee2e6;
            margin-bottom: 15px;
        }

        .empty-chat h5 {
            color: #6c757d;
            margin-bottom: 10px;
        }

        .empty-chat p {
            color: #adb5bd;
            font-size: 14px;
        }

    /* Animations */
    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes typing {
        0%, 60%, 100% {
            transform: translateY(0);
        }

        30% {
            transform: translateY(-4px);
        }
    }

    /* Scrollbar Styling */
    .chat-messages::-webkit-scrollbar {
        width: 6px;
    }

    .chat-messages::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 3px;
    }

    .chat-messages::-webkit-scrollbar-thumb {
        background: var(--primary-red);
        border-radius: 3px;
    }

        .chat-messages::-webkit-scrollbar-thumb:hover {
            background: #e02020;
        }

    /* Loading Spinner */
    .loading-spinner {
        display: inline-block;
        width: 20px;
        height: 20px;
        border: 3px solid rgba(255,255,255,.3);
        border-radius: 50%;
        border-top-color: white;
        animation: spin 1s ease-in-out infinite;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    .password-toggle {
        position: absolute;
        right: 15px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        color: #6c757d;
        cursor: pointer;
        z-index: 3;
    }

        .password-toggle:hover {
            color: var(--primary-red);
        }

    .brand-header {
        text-align: center;
        margin-bottom: 30px;
    }

    .brand-logo {
        width: 160px;
        margin-bottom: 15px;
    }

    .security-note {
        background: linear-gradient(135deg, #f8f9fa, #e9ecef);
        border-inline-start: 4px solid var(--primary-red);
        padding: 15px;
        border-radius: 8px;
        margin-top: 20px;
        font-size: 14px;
    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .search-header {
            padding: 20px 15px;
        }

        .form-control-custom {
            padding: 12px;
        }

        .btn-search {
            padding: 12px 20px;
        }

        .search-icon {
            width: 50px;
            height: 50px;
            font-size: 20px;
        }

        .reference-number {
            font-size: 1.8rem;
        }

        .detail-row {
            flex-direction: column;
            align-items: flex-start;
        }

        .detail-label {
            flex: none;
            margin-bottom: 5px;
            width: 100%;
        }

        .case-info-box {
            flex-direction: column;
            gap: 10px;
            margin-top: 15px;
        }

        .action-buttons {
            justify-content: flex-end;
            margin-top: 15px;
        }

        .timeline-vertical {
            padding-inline-start: 20px;
        }

        .timeline-point {
            left: -30px;
        }

        .chat-container {
            height: 300px;
        }

        .message-bubble {
            max-width: 90%;
        }

        .chat-input-area {
            padding: 10px;
        }

        .attachments-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

        <div class="col-lg-12 col-xl-12">
            <!-- Search Card -->
            <div class="search-card mt-3">
                <!-- Header -->
                <div class="search-header text-center">
                    <img src="~/ShareIt-logo.png" alt="ELSEWEDY ELECTRIC" class="brand-logo" />
                    <h2 class="h4 mb-2">@L["Track Your Ticket"]</h2>
                    <p class="mb-0 opacity-75">@L["Enter your ticket reference and password to check status"]</p>
                </div>

                <!-- Search Form -->
                <div class="p-4 p-md-5">
                    <form asp-action="Index" method="post" id="searchForm" class="needs-validation" novalidate>
                        @Html.AntiForgeryToken()

                        <!-- Messages -->
                        @if (!string.IsNullOrEmpty(Model.Message))
                        {
                            <div class="alert-custom alert-@(Model.MessageType ?? "info")-custom mb-4">
                                <div class="d-flex align-items-center">
                                    <i class="fas @GetAlertIcon(Model.MessageType) me-3 fa-lg"></i>
                                    <div>
                                        <div class="fw-bold mb-1">@GetAlertTitle(Model.MessageType)</div>
                                        <div class="small">@Html.Raw(Model.Message)</div>
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="row g-4">
                            <!-- Ticket Reference -->
                            <div class="col-12">
                                <label asp-for="TicketRef" class="form-label fw-bold mb-2">
                                    <i class="fas fa-hashtag text-danger me-2"></i>@L["Ticket Reference Number"]
                                </label>
                                <div class="input-group-custom">
                                    <i class="fas fa-file-invoice input-icon"></i>
                                    <input asp-for="TicketRef"
                                           class="form-control form-control-custom input-with-icon"
                                           placeholder="@L["Enter your ticket reference number"]"
                                           required />
                                </div>
                                <span asp-validation-for="TicketRef" class="text-danger small mt-1"></span>
                            </div>

                            <!-- Password -->
                            <div class="col-12">
                                <label asp-for="Password" class="form-label fw-bold mb-2">
                                    <i class="fas fa-key text-danger me-2"></i>@L["Password"]
                                </label>
                                <div class="input-group-custom">
                                    <i class="fas fa-lock input-icon"></i>
