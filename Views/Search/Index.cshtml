                                <div class="col-md-8">
                                    <div class="d-flex align-items-center">
                                        <div class="header-icon me-3">
                                            <i class="fas fa-file-invoice"></i>
                                        </div>
                                        <div>
                                            <h4 class="mb-1 fw-bold">@L["Ticket Case Details"]</h4>
