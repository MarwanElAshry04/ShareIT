                                        <input type="hidden" name="ticketRef" value="@Model.TicketRef" />
                                        <button type="submit" class="forgot-password-link">
                                            <i class="fas fa-question-circle me-1"></i>@L["Forgot your password?"]
                                        </button>
                                    </form>
                                </div>
                            }

                            <!-- Submit Button -->
                            <div class="col-12">
                                <button type="submit" class="btn-search" id="searchButton">
                                    <span id="buttonText">
                                        <i class="fas fa-search me-2"></i>@L["Search Ticket"]
                                    </span>
                                    <span id="loadingSpinner" class="d-none">
                                        <span class="loading-spinner me-2"></span>@L["Searching..."]
                                    </span>
                                </button>
                            </div>
                        </div>
                    </form>

                    <!-- Security Note -->
                    <div class="security-note mt-4">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-shield-alt text-danger me-3"></i>
                            <div class="small">
                                <strong>@L["Security Notice:"]</strong> @L["Your information is protected with 256-bit encryption. All data transmission is secure and confidential."]
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Ticket Details Section -->
            @if (Model.ShowTicketDetails && Model.TicketDetails != null)
