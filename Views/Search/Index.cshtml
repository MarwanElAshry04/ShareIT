@functions {
    public string GetAlertIcon(string messageType)
    {
        return messageType switch
        {
            "success" => "fa-check-circle",
            "danger" => "fa-exclamation-circle",
            "warning" => "fa-exclamation-triangle",
            _ => "fa-info-circle"
        };
    }

    public string GetAlertTitle(string messageType)
    {
        return messageType switch
        {
            "success" => "Success",
            "danger" => "Attention Required",
            "warning" => "Warning",
            _ => "Information"
        };
    }

    public string GetFileIcon(string extension)
    {
        return extension switch
        {
            ".docx" or ".doc" => "fas fa-file-word text-primary",
            ".pdf" => "fas fa-file-pdf text-danger",
            ".xlsx" or ".xls" => "fas fa-file-excel text-success",
            ".jpg" or ".jpeg" or ".png" => "fas fa-file-image text-info",
            ".mp3" or ".wav" => "fas fa-file-audio text-warning",
            ".mp4" or ".avi" => "fas fa-file-video text-purple",
            _ => "fas fa-file text-secondary"
        };
    }
}

@section Scripts {
    <script>
        $(document).ready(function () {
            // Password visibility toggle
            $('#togglePassword').click(function () {
                const passwordInput = $('#passwordInput');
                const type = passwordInput.attr('type') === 'password' ? 'text' : 'password';
                passwordInput.attr('type', type);
                $(this).find('i').toggleClass('fa-eye fa-eye-slash');
            });

            // Form submission handling
            $('#searchForm').on('submit', function (e) {
                if ($(this)[0].checkValidity()) {
                    // Show loading state
                    $('#buttonText').addClass('d-none');
                    $('#loadingSpinner').removeClass('d-none');
                    $('#searchButton').prop('disabled', true);

                    // Auto-hide alert after 8 seconds
                    setTimeout(function () {
                        $('.alert-custom').fadeOut(500);
                    }, 8000);
                }
            });

            // Auto-focus on first input
            $('#TicketRef').focus();

            // Form validation styling
            $('.form-control-custom').on('blur', function () {
                if ($(this).val().trim() !== '') {
                    $(this).removeClass('is-invalid').addClass('is-valid');
                } else {
                    $(this).removeClass('is-valid').addClass('is-invalid');
                }
            });

            // Input animation on focus
            $('.form-control-custom').on('focus', function () {
                $(this).parent().css('transform', 'translateY(-2px)');
            }).on('blur', function () {
                $(this).parent().css('transform', 'translateY(0)');
            });

            // Chat functionality
            const ticketId = @(Model.TicketDetails?.Ticket?.Id ?? 0);
            let isTyping = false;
            let currentDate = '';
            let messageCount = 0;

            // Initialize chat if ticket exists
            if (ticketId > 0) {
                loadChatMessages();
                startPolling();
            }

            // Load chat messages
            function loadChatMessages() {
                $('#chatMessages').html(`
                    <div class="chat-loading text-center py-4">
                        <div class="spinner-border text-danger" role="status">
                            <span class="visually-hidden">@L["Loading..."]</span>
                        </div>
                        <p class="text-muted mt-2">@L["Loading messages..."]</p>
                    </div>
                `);

                $.ajax({
                    url: '@Url.Action("GetChatMessages", "Search")',
                    type: 'GET',
                    data: { ticketId: ticketId },
                    success: function (response) {
                        if (response.success) {
                            messageCount = response.messages.length;
                            renderMessages(response.messages);
                            scrollToBottom();
                        }
                    },
                    error: function () {
                        $('#chatMessages').html(`
                            <div class="empty-chat">
                                <i class="fas fa-comment-slash"></i>
                                <h5>@L["Failed to load messages"]</h5>
                                <p>@L["Please try again later"]</p>
                            </div>
                        `);
                    }
                });
            }

            // Render messages
            function renderMessages(messages) {
                if (messages.length === 0) {
                    $('#chatMessages').html(`
                        <div class="empty-chat">
                            <i class="fas fa-comments"></i>
                            <h5>@L["No messages yet"]</h5>
                            <p>@L["Start the conversation with compliance team"]</p>
                        </div>
                    `);
                    return;
                }

                let html = '';
                currentDate = '';
                let previousDate = '';

                messages.forEach(function (message) {
                    const messageDate = new Date(message.createdOn).toDateString();

                    // Add date separator if date changed
                    if (currentDate !== messageDate) {
                        currentDate = messageDate;
                        const formattedDate = new Date(message.createdOn).toLocaleDateString('en-US', {
                            weekday: 'long',
                            year: 'numeric',
                            month: 'long',
                            day: 'numeric'
                        });
                        html += `
                            <div class="date-separator">
                                <span class="date-label">${formattedDate}</span>
                            </div>
                        `;
                    }

                    const messageClass = message.senderType === 'user' ? 'message-user' : 'message-compliance';
                    const senderName = message.senderType === 'user' ? 'You' : 'Compliance Team';

                    html += `
                        <div class="message-bubble ${messageClass}">
                            <div class="message-header">
                                <span class="message-sender">${senderName}</span>
                                <span class="message-time">${formatTime(new Date(message.createdOn))}</span>
                            </div>
                            <div class="message-content">
                                <div class="message-text">${escapeHtml(message.comment)}</div>
                            </div>
                        </div>
                    `;
                });

                $('#chatMessages').html(html);
            }

            // Send message
            $('#sendMessageBtn').click(sendMessage);

            $('#messageInput').keydown(function (e) {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    sendMessage();
                }
            });

            function sendMessage() {
                const message = $('#messageInput').val().trim();

                if (!message || isTyping) return;

                if (message.length > 1000) {
                    showAlert('Message cannot exceed 1000 characters', 'danger');
                    return;
                }

                isTyping = true;
                $('#sendMessageBtn').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i>');

                $.ajax({
                    url: '@Url.Action("SendMessage", "Search")',
                    type: 'POST',
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    data: {
                        TicketId: ticketId,
                        Message: message
                    },
                    success: function (response) {
                        if (response.success) {
                            // Add message to chat
                            const newMessage = {
                                id: response.chatId,
                                comment: message,
                                sender: 'You',
                                senderType: 'user',
                                createdOn: new Date(),
                                formattedTime: response.time,
                                formattedDate: response.date
                            };

                            $('#chatMessages .empty-chat').remove();
                            const messageHtml = renderSingleMessage(newMessage);
                            $('#chatMessages').append(messageHtml);
                            $('#messageInput').val('');
                            scrollToBottom();
                            messageCount++;

                            showAlert('Message sent successfully', 'success');
                        } else {
                            showAlert(response.message || 'Failed to send message', 'danger');
                        }
                    },
                    error: function (xhr, status, error) {
                        showAlert('Error sending message: ' + error, 'danger');
                    },
                    complete: function () {
                        isTyping = false;
                        $('#sendMessageBtn').prop('disabled', false).html('<i class="fas fa-paper-plane"></i>');
                    }
                });
            }

            // File attachment
            $('#attachFileBtn').click(function () {
                $('#fileInput').click();
            });

            $('#fileInput').change(function () {
                if (this.files.length > 0) {
                    uploadFile(this.files[0]);
                }
            });

            function uploadFile(file) {
                const formData = new FormData();
                formData.append('ticketId', ticketId);
                formData.append('file', file);

                $('.upload-progress').show();
                const progressBar = $('.upload-progress .progress-bar');

                $.ajax({
                    url: '@Url.Action("UploadChatAttachment", "Search")',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    xhr: function () {
                        const xhr = new window.XMLHttpRequest();
                        xhr.upload.addEventListener('progress', function (e) {
                            if (e.lengthComputable) {
                                const percent = Math.round((e.loaded / e.total) * 100);
                                progressBar.css('width', percent + '%').text(percent + '%');
                            }
                        });
                        return xhr;
                    },
                    success: function (response) {
                        if (response.success) {
                            showAlert('File uploaded successfully', 'success');
                            loadChatMessages(); // Reload messages to show attachment
                        } else {
                            showAlert(response.message || 'Failed to upload file', 'danger');
                        }
                    },
                    error: function () {
                        showAlert('Error uploading file', 'danger');
                    },
                    complete: function () {
                        $('.upload-progress').hide();
                        progressBar.css('width', '0%').text('');
                        $('#fileInput').val('');
                    }
                });
            }

            // Auto-refresh messages every 30 seconds
            function startPolling() {
                setInterval(function () {
                    if (document.hasFocus()) {
                        checkNewMessages();
                    }
                }, 30000);
            }

            function checkNewMessages() {
                $.ajax({
                    url: '@Url.Action("GetChatMessages", "Search")',
                    type: 'GET',
                    data: { ticketId: ticketId },
                    success: function (response) {
                        if (response.success) {
                            const newCount = response.messages.length;
                            if (newCount > messageCount) {
                                const newMessagesCount = newCount - messageCount;
                                messageCount = newCount;
                                loadChatMessages();
                                showNotification('New message received from compliance team');
                                updateUnreadCount(newMessagesCount);
                            }
                        }
                    }
                });
            }

            function updateUnreadCount(count) {
                if (count > 0) {
                    $('#unreadCount').text(count + ' new').show();
                } else {
                    $('#unreadCount').hide();
                }
            }

            function showNotification(message) {
                if (!("Notification" in window)) return;

                if (Notification.permission === "granted") {
                    new Notification("ELSEWEDY Compliance", {
                        body: message,
                        icon: '/ShareIt-logo.png'
                    });
                }
                else if (Notification.permission !== "denied") {
                    Notification.requestPermission().then(function (permission) {
                        if (permission === "granted") {
                            new Notification("ELSEWEDY Compliance", {
                                body: message,
                                icon: '/ShareIt-logo.png'
                            });
                        }
                    });
                }
            }

            // Render single message
            function renderSingleMessage(message) {
                const messageDate = new Date(message.createdOn).toDateString();
                let html = '';

                // Check if we need date separator
                if (currentDate !== messageDate) {
                    currentDate = messageDate;
                    const formattedDate = new Date(message.createdOn).toLocaleDateString('en-US', {
                        weekday: 'long',
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric'
                    });
                    html += `
                        <div class="date-separator">
                            <span class="date-label">${formattedDate}</span>
                        </div>
                    `;
                }

                const messageClass = message.senderType === 'user' ? 'message-user' : 'message-compliance';
                const senderName = message.senderType === 'user' ? 'You' : 'Compliance Team';

                html += `
                    <div class="message-bubble ${messageClass}">
                        <div class="message-header">
                            <span class="message-sender">${senderName}</span>
                            <span class="message-time">${formatTime(new Date(message.createdOn))}</span>
                        </div>
                        <div class="message-content">
                            <div class="message-text">${escapeHtml(message.comment)}</div>
                        </div>
                    </div>
                `;

                return html;
            }

            // Helper functions
            function scrollToBottom() {
                const chatMessages = $('#chatMessages')[0];
                if (chatMessages) {
                    chatMessages.scrollTop = chatMessages.scrollHeight;
                }
            }

            function formatTime(date) {
                return date.toLocaleTimeString('en-US', {
                    hour: '2-digit',
                    minute: '2-digit',
                    hour12: true
                });
            }

            function escapeHtml(text) {
                const div = document.createElement('div');
                div.textContent = text;
                return div.innerHTML;
            }

            function showAlert(message, type) {
                const alertHtml = `
                    <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                        ${message}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                `;

                $('.chat-container').before(alertHtml);

                setTimeout(function () {
                    $('.alert').alert('close');
                }, 5000);
            }

            // Auto-expand textarea
            $('#messageInput').on('input', function () {
                this.style.height = 'auto';
                this.style.height = (this.scrollHeight) + 'px';
            });

            // Initialize textarea height
            $('#messageInput').trigger('input');

            @if (Model.ShowTicketDetails)
            {
                    <text>
                    // Scroll to ticket details after successful search
                    setTimeout(function() {
                        $('html, body').animate({
                            scrollTop: $('#ticketDetails').offset().top - 100
                        }, 800);
                    }, 500);
                    </text>
            }
        });

        // Print ticket details
        function printTicket() {
            const printContent = document.getElementById('ticketDetails').innerHTML;
            const originalContent = document.body.innerHTML;

            document.body.innerHTML = printContent;
            window.print();
            document.body.innerHTML = originalContent;
            location.reload();
        }

        // Scroll to top
        function scrollToTop() {
            $('html, body').animate({
                scrollTop: 0
            }, 500);
        }

        // Download attachment
        function downloadAttachment(filePath, fileName) {
            const link = document.createElement('a');
            link.href = filePath;
            link.download = fileName;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        // Clear form and start new search
        function newSearch() {
            $('#TicketRef').val('');
            $('#Password').val('');
            $('#ticketDetails').fadeOut(300, function () {
                $(this).remove();
                $('#TicketRef').focus();
            });
        }

        // Re-enable button if form validation fails
        document.addEventListener('invalid', (function () {
            return function (e) {
                e.preventDefault();
                $('#loadingSpinner').addClass('d-none');
                $('#buttonText').removeClass('d-none');
                $('#searchButton').prop('disabled', false);
            };
        })(), true);
    </script>
}