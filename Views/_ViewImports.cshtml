@using ShareIT
@using ShareIT.Models
@using System.Globalization
@using Microsoft.AspNetCore.Mvc.Localization
@* IHtmlLocalizer<SharedResource>, not IViewLocalizer: the latter resolves per-view
   resource files (Resources/Views/Shared/_Layout.ar.resx) rather than the single
   shared Resources/SharedResource.ar.resx this project uses. *@
@inject IHtmlLocalizer<SharedResource> L
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
