@model ShareIT.Models.ViewModel.DocumentViewModel
@{
    ViewData["Title"] = "Edit Document";
    Layout = "~/Views/Shared/_Admin.cshtml";

}

<style>
    .edit-container {
        max-width: 800px;
        margin: 0 auto;
        padding: 30px 20px;
    }

    .existing-file {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 20px;
    }

    .existing-file-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
    }

    .file-badge {
        background: #28a745;
        color: white;
        padding: 4px 10px;
        border-radius: 15px;
        font-size: 12px;
        font-weight: 500;
    }

    .existing-file-content {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .existing-file-icon {
        font-size: 36px;
        color: #c4252a;
    }

    .existing-file-info h6 {
        margin: 0;
        color: #343a40;
    }

    .existing-file-info small {
        color: #6c757d;
    }

    .existing-file-actions {
        display: flex;
        gap: 10px;
        margin-top: 10px;
    }

    .btn-view-file {
        background: #007bff;
        color: white;
        border: none;
        padding: 5px 15px;
        border-radius: 5px;
        font-size: 14px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

        .btn-view-file:hover {
            background: #0056b3;
            color: white;
            text-decoration: none;
        }

    .warning-note {
        background: #fff3cd;
        border: 1px solid #ffc107;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 20px;
    }

    /* Reuse styles from create form */
    .form-header {
        background: linear-gradient(135deg, #007bff, #0056b3);
        color: white;
        padding: 20px;
        border-radius: 10px 10px 0 0;
        margin-bottom: 0;
    }

    .form-card {
        border: 1px solid #dee2e6;
        border-radius: 10px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        overflow: hidden;
    }

    .form-body {
        padding: 30px;
        background: white;
    }

    .form-group label {
        font-weight: 600;
        color: #343a40;
        margin-bottom: 8px;
    }

    .form-control, .form-control-file {
        border: 2px solid #e9ecef;
        border-radius: 8px;
        padding: 12px 15px;
        font-size: 16px;
        transition: all 0.3s;
    }

        .form-control:focus, .form-control-file:focus {
            border-color: #007bff;
            box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
        }

    .file-upload-area {
        border: 2px dashed #dee2e6;
        border-radius: 10px;
        padding: 20px;
        text-align: center;
        background: #f8f9fa;
        cursor: pointer;
        transition: all 0.3s;
        margin-bottom: 15px;
    }

        .file-upload-area:hover {
            border-color: #007bff;
            background: #e7f3ff;
        }

        .file-upload-area i {
            font-size: 36px;
            color: #007bff;
            margin-bottom: 10px;
        }

    .btn-update {
        background: linear-gradient(135deg, #007bff, #0056b3);
        color: white;
        border: none;
        padding: 12px 30px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 16px;
        transition: all 0.3s;
        width: 100%;
    }

        .btn-update:hover {
            background: linear-gradient(135deg, #0056b3, #003d82);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 91, 187, 0.3);
        }

        .btn-update:disabled {
            background: #6c757d;
            transform: none;
            box-shadow: none;
        }

    .btn-cancel {
        background: #f8f9fa;
        color: #6c757d;
        border: 1px solid #dee2e6;
        padding: 12px 30px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 16px;
        transition: all 0.3s;
        width: 100%;
        text-decoration: none;
        text-align: center;
        display: block;
    }

        .btn-cancel:hover {
            background: #e9ecef;
            color: #343a40;
            text-decoration: none;
        }

    .field-validation-error {
        color: #dc3545;
        font-size: 14px;
        margin-top: 5px;
        display: block;
    }

    .file-info {
        margin-top: 5px;
        font-size: 12px;
        color: #6c757d;
    }

    .spinner {
        display: inline-block;
        width: 20px;
        height: 20px;
        border: 3px solid rgba(255,255,255,.3);
        border-radius: 50%;
        border-top-color: white;
        animation: spin 1s ease-in-out infinite;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }
</style>

<div class="edit-container">
    <!-- Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="form-card">
        <!-- Header -->
        <div class="form-header">
            <h3 class="mb-0">
                <i class="fas fa-edit me-2"></i>
                Edit Document
            </h3>
            <p class="mb-0 opacity-75">Update document information and files</p>
        </div>

        <!-- Form -->
        <div class="form-body">
            <form asp-action="Edit" method="post" enctype="multipart/form-data" id="editForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="warning-note">
                    <i class="fas fa-exclamation-triangle text-warning me-2"></i>
                    <strong>Note:</strong> Leave file fields empty to keep existing files
                </div>

                <!-- Existing PDF File -->
                @if (!string.IsNullOrEmpty(Model.ExistingFilePath))
                {
                    <div class="existing-file">
                        <div class="existing-file-header">
                            <h6 class="mb-0">
                                <i class="fas fa-file-pdf text-danger me-2"></i>
                                Current PDF Document
                            </h6>
                            <span class="file-badge">Current File</span>
                        </div>
                        <div class="existing-file-content">
                            <i class="fas fa-file-pdf existing-file-icon"></i>
                            <div class="existing-file-info">
                                <small>Uploaded on: @System.IO.File.GetLastWriteTime(Model.ExistingFilePath).ToString("dd MMM yyyy")</small>
                            </div>
                        </div>
                        <div class="existing-file-actions">
                            <a href="@Model.ExistingFilePath" class="btn-view-file" target="_blank">
                                <i class="fas fa-eye"></i> View
                            </a>
                        </div>
                    </div>
                }

                <!-- Existing Logo -->
                @if (!string.IsNullOrEmpty(Model.ExistingLogoPath))
                {
                    <div class="existing-file">
                        <div class="existing-file-header">
                            <h6 class="mb-0">
                                <i class="fas fa-image text-danger me-2"></i>
                                Current Logo
                            </h6>
                            <span class="file-badge">Current Logo</span>
                        </div>
                        <div class="existing-file-content">
                            <img src="@Model.ExistingLogoPath" alt="Current Logo" style="width: 50px; height: 50px; border-radius: 5px;" />
                            <div class="existing-file-info">
                                <small>Current document logo</small>
                            </div>
                        </div>
                    </div>
                }

                <!-- Document Name -->
                <div class="form-group mb-4">
                    <label asp-for="Name" class="form-label">
                        <i class="fas fa-file-alt me-2 text-danger"></i>
                        Document Name *
                    </label>
                    <input asp-for="Name" class="form-control"
                           placeholder="Enter document name" />
                    <span asp-validation-for="Name" class="field-validation-error"></span>
                </div>

                <!-- Description -->
                <div class="form-group mb-4">
                    <label asp-for="Description" class="form-label">
                        <i class="fas fa-align-left me-2 text-danger"></i>
                        Description
                    </label>
                    <textarea asp-for="Description" class="form-control" rows="3"
                              placeholder="Enter document description"></textarea>
                    <span asp-validation-for="Description" class="field-validation-error"></span>
                </div>

                <!-- Display Order -->
                <div class="form-group mb-4">
                    <label asp-for="DisplayOrder" class="form-label">
                        <i class="fas fa-sort-numeric-down me-2 text-danger"></i>
                        Display Order
                    </label>
                    <input asp-for="DisplayOrder" type="number" class="form-control"
                           placeholder="Enter display order" />
                    <span asp-validation-for="DisplayOrder" class="field-validation-error"></span>
                    <small class="text-muted">Documents are sorted by this number</small>
                </div>

                <!-- Update PDF File (Optional) -->
                <div class="form-group mb-4">
                    <label class="form-label">
                        <i class="fas fa-file-pdf me-2 text-danger"></i>
                        Update PDF Document (Optional)
                    </label>
                    <div class="file-upload-area" onclick="document.getElementById('PdfFile').click()">
                        <i class="fas fa-upload"></i>
                        <h6 class="mb-2">Click to upload new PDF</h6>
                        <p class="text-muted mb-0">Leave empty to keep current file</p>
                        <p class="text-muted">Maximum: 50MB | Format: .pdf</p>
                    </div>
                    <input asp-for="PdfFile" type="file" class="form-control-file d-none"
                           id="PdfFile" accept=".pdf" />
                    <div class="file-info" id="pdfFileInfo"></div>
                </div>

                <!-- Update Logo (Optional) -->
                <div class="form-group mb-4">
                    <label class="form-label">
                        <i class="fas fa-image me-2 text-danger"></i>
                        Update Logo (Optional)
                    </label>
                    <div class="file-upload-area" onclick="document.getElementById('LogoFile').click()">
                        <i class="fas fa-upload"></i>
                        <h6 class="mb-2">Click to upload new logo</h6>
                        <p class="text-muted mb-0">Leave empty to keep current logo</p>
                        <p class="text-muted">Maximum: 5MB | Formats: .jpg, .jpeg, .png, .gif, .svg</p>
                    </div>
                    <input asp-for="LogoFile" type="file" class="form-control-file d-none"
                           id="LogoFile" accept=".jpg,.jpeg,.png,.gif,.svg" />
                    <div class="file-info" id="logoFileInfo"></div>
                </div>

                <!-- Form Actions -->
                <div class="row mt-5">
                    <div class="col-md-6 mb-3">
                        <a asp-action="Index" class="btn-cancel">
                            <i class="fas fa-arrow-left me-2"></i>Cancel
                        </a>
                    </div>
                    <div class="col-md-6 mb-3">
                        <button type="submit" class="btn-update" id="submitBtn">
                            <span id="btnText">
                                <i class="fas fa-save me-2"></i>Update Document
                            </span>
                            <span id="btnSpinner" class="d-none">
                                <span class="spinner me-2"></span>Updating...
                            </span>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Handle PDF file selection
            $('#PdfFile').change(function(e) {
                if (this.files.length > 0) {
                    const file = this.files[0];
                    const fileSize = formatFileSize(file.size);
                    $('#pdfFileInfo').html(`
                        <div class="text-success">
                            <i class="fas fa-check-circle me-1"></i>
                            New file selected: <strong>${file.name}</strong> (${fileSize})
                        </div>
                        <small class="text-muted">This will replace the current PDF file</small>
                    `);
                } else {
                    $('#pdfFileInfo').html('<div class="text-muted">No new file selected</div>');
                }
            });

            // Handle logo file selection
            $('#LogoFile').change(function(e) {
                if (this.files.length > 0) {
                    const file = this.files[0];
                    const fileSize = formatFileSize(file.size);
                    $('#logoFileInfo').html(`
                        <div class="text-success">
                            <i class="fas fa-check-circle me-1"></i>
                            New logo selected: <strong>${file.name}</strong> (${fileSize})
                        </div>
                        <small class="text-muted">This will replace the current logo</small>
                    `);
                } else {
                    $('#logoFileInfo').html('<div class="text-muted">No new logo selected</div>');
                }
            });

            // Form submission
            $('#editForm').on('submit', function(e) {
                if ($(this).valid()) {
                    $('#btnText').addClass('d-none');
                    $('#btnSpinner').removeClass('d-none');
                    $('#submitBtn').prop('disabled', true);
                }
            });

            // Validate file size
            $('#PdfFile, #LogoFile').on('change', function() {
                const file = this.files[0];
                const maxSize = this.id === 'PdfFile' ? 50 * 1024 * 1024 : 5 * 1024 * 1024;

                if (file && file.size > maxSize) {
                    alert(`File size exceeds maximum limit (${formatFileSize(maxSize)})`);
                    this.value = '';

                    if (this.id === 'PdfFile') {
                        $('#pdfFileInfo').html('<div class="text-danger">File too large</div>');
                    } else {
                        $('#logoFileInfo').html('<div class="text-danger">File too large</div>');
                    }
                }
            });
        });

        // Helper function to format file size
        function formatFileSize(bytes) {
            if (bytes === 0) return '0 Bytes';

            const k = 1024;
            const sizes = ['Bytes', 'KB', 'MB', 'GB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));

            return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
        }
    </script>
}