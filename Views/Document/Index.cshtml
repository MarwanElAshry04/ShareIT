@model List<ShareIT.Models.Document>
@{
    ViewData["Title"] = "Manage Documents";
    Layout = "~/Views/Shared/_Admin.cshtml";

}

<style>
    .manage-container {
        padding: 30px 0;
    }

    .page-header {
        background: linear-gradient(135deg, #343a40, #212529);
        color: white;
        padding: 25px;
        border-radius: 10px;
        margin-bottom: 30px;
    }

    .stats-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: white;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 20px;
        text-align: center;
        transition: all 0.3s;
    }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
        }

        .stat-card i {
            font-size: 36px;
            margin-bottom: 15px;
        }

        .stat-card .count {
            font-size: 32px;
            font-weight: 700;
            color: #c4252a;
            margin-bottom: 5px;
        }

        .stat-card .label {
            color: #6c757d;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

    .documents-table {
        background: white;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
    }

    .table-header {
        background: #f8f9fa;
        padding: 20px;
        border-bottom: 2px solid #c4252a;
    }

        .table-header h5 {
            margin: 0;
            color: #343a40;
        }

    .table-responsive {
        overflow-x: auto;
    }

    .table {
        margin: 0;
    }

        .table thead th {
            background: #f8f9fa;
            border-bottom: 2px solid #dee2e6;
            font-weight: 600;
            color: #495057;
            padding: 15px;
            white-space: nowrap;
        }

        .table tbody td {
            padding: 15px;
            vertical-align: middle;
            border-bottom: 1px solid #f8f9fa;
        }

        .table tbody tr:hover {
            background: #f8f9fa;
        }

    .logo-cell {
        text-align: center;
    }

    .document-logo {
        width: 40px;
        height: 40px;
        border-radius: 5px;
        object-fit: cover;
        border: 1px solid #dee2e6;
    }

    .default-logo {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f8f9fa;
        border-radius: 5px;
        color: #c4252a;
        font-size: 20px;
    }

    .document-name {
        font-weight: 500;
        color: #343a40;
        margin-bottom: 5px;
    }

    .document-description {
        font-size: 12px;
        color: #6c757d;
        line-height: 1.4;
        max-width: 300px;
        overflow: hidden;
        text-overflow: ellipsis;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    .order-badge {
        background: #e9ecef;
        color: #495057;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 500;
        min-width: 40px;
        text-align: center;
    }

    .action-buttons {
        display: flex;
        gap: 8px;
    }

    .btn-action {
        width: 36px;
        height: 36px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: none;
        color: white;
        transition: all 0.3s;
        text-decoration: none;
    }

    .btn-edit {
        background: #007bff;
    }

        .btn-edit:hover {
            background: #0056b3;
            transform: translateY(-2px);
        }

    .btn-delete {
        background: #dc3545;
    }

        .btn-delete:hover {
            background: #c82333;
            transform: translateY(-2px);
        }

    .btn-view {
        background: #28a745;
    }

        .btn-view:hover {
            background: #218838;
            transform: translateY(-2px);
        }

    .btn-download {
        background: #17a2b8;
    }

        .btn-download:hover {
            background: #138496;
            transform: translateY(-2px);
        }

    .no-documents {
        text-align: center;
        padding: 60px 20px;
        color: #6c757d;
    }

        .no-documents i {
            font-size: 48px;
            margin-bottom: 20px;
            opacity: 0.3;
        }

    .btn-create {
        background: linear-gradient(135deg, #28a745, #20c997);
        color: white;
        border: none;
        padding: 12px 25px;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        transition: all 0.3s;
    }

        .btn-create:hover {
            background: linear-gradient(135deg, #218838, #1e9e8a);
            color: white;
            text-decoration: none;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(40, 167, 69, 0.3);
        }

    .search-box {
        max-width: 300px;
    }

    .pagination-container {
        padding: 20px;
        border-top: 1px solid #dee2e6;
        background: #f8f9fa;
    }
</style>

<div class="container manage-container">
    <!-- Header -->
    <div class="page-header">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h2 class="mb-2">
                    <i class="fas fa-file-contract me-2"></i>
                    Manage Documents
                </h2>
                <p class="mb-0 opacity-75">Upload and manage compliance documents and policies</p>
            </div>
            <div class="col-md-4 text-md-end">
                <a asp-action="Create" class="btn-create">
                    <i class="fas fa-plus-circle"></i> Create New
                </a>
            </div>
        </div>
    </div>

    <!-- Statistics -->
    <div class="stats-cards">
        <div class="stat-card">
            <i class="fas fa-file-alt text-primary"></i>
            <div class="count">@Model.Count</div>
            <div class="label">Total Documents</div>
        </div>
        <div class="stat-card">
            <i class="fas fa-image text-success"></i>
            <div class="count">@Model.Count(d => !string.IsNullOrEmpty(d.Logo))</div>
            <div class="label">With Logos</div>
        </div>
        <div class="stat-card">
            <i class="fas fa-sort-numeric-up text-warning"></i>
            <div class="count">@(Model.Any() ? Model.Max(d => d.DisplayOrder) : 0)</div>
            <div class="label">Highest Order</div>
        </div>
        <div class="stat-card">
            <i class="fas fa-clock text-info"></i>
            <div class="count">@Model.OrderByDescending(d => d.CreatedOn).FirstOrDefault()?.CreatedOn.ToString()</div>
            <div class="label">Last Updated</div>
        </div>
    </div>

    <!-- Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Documents Table -->
    <div class="documents-table">
        <div class="table-header">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <h5 class="mb-0">
                        <i class="fas fa-list me-2"></i>
                        All Documents
                    </h5>
                </div>
                <div class="col-md-6">
                    <div class="input-group search-box ms-auto">
                        <input type="text" class="form-control" placeholder="Search documents..." id="searchInput">
                        <button class="btn btn-outline-secondary" type="button">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover" id="documentsTable">
                    <thead>
                        <tr>
                            <th width="60">Order</th>
                            <th width="80">Logo</th>
                            <th>Document Name</th>
                            <th>Description</th>
                            <th width="180">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var document in Model.OrderBy(d => d.DisplayOrder).ThenBy(d => d.Name))
                        {
                            <tr data-document-id="@document.Id">
                                <td>
                                    <span class="order-badge">@document.DisplayOrder</span>
                                </td>
                                <td class="logo-cell">
                                    @if (!string.IsNullOrEmpty(document.Logo))
                                    {
                                        <img src="@document.Logo" alt="Logo" class="document-logo">
                                    }
                                    else
                                    {
                                        <div class="default-logo">
                                            <i class="fas fa-file-pdf"></i>
                                        </div>
                                    }
                                </td>
                                <td>
                                    <div class="document-name">@document.Name</div>
                                   
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(document.Description))
                                    {
                                        <div class="document-description" title="@document.Description">
                                            @document.Description
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">No description</span>
                                    }
                                </td>
                                <td>
                                    <div class="action-buttons">
                                        <a href="@document.FilePath" class="btn-action btn-view" target="_blank"
                                           title="View Document">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Download" asp-route-id="@document.Id" class="btn-action btn-download"
                                           title="Download Document">
                                            <i class="fas fa-download"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@document.Id" class="btn-action btn-edit"
                                           title="Edit Document">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@document.Id" class="btn-action btn-delete"
                                           title="Delete Document" onclick="return confirm('Are you sure you want to delete this document?')">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="no-documents">
                <i class="fas fa-file-alt"></i>
                <h4>No Documents Found</h4>
                <p class="mb-4">You haven't uploaded any documents yet.</p>
                <a asp-action="Create" class="btn-create">
                    <i class="fas fa-plus-circle"></i> Create Your First Document
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Search functionality
            $('#searchInput').on('keyup', function () {
                const searchText = $(this).val().toLowerCase();

                $('#documentsTable tbody tr').each(function () {
                    const documentName = $(this).find('.document-name').text().toLowerCase();
                    const description = $(this).find('.document-description').text().toLowerCase();

                    if (documentName.includes(searchText) || description.includes(searchText)) {
                        $(this).show();
                    } else {
                        $(this).hide();
                    }
                });
            });

            // Row hover effects
            $('#documentsTable tbody tr').hover(
                function () {
                    $(this).css('transform', 'translateX(5px)');
                },
                function () {
                    $(this).css('transform', 'translateX(0)');
                }
            );

            // Auto-hide alerts after 5 seconds
            setTimeout(function () {
                $('.alert').alert('close');
            }, 5000);

            // Confirm delete with sweet alert (optional)
            $('.btn-delete').click(function (e) {
                if (!confirm('Are you sure you want to delete this document? This action cannot be undone.')) {
                    e.preventDefault();
                }
            });

            // Sort by display order
            $('#documentsTable').DataTable({
                "paging": true,
                "searching": true,
                "ordering": true,
                "info": false,
                "lengthChange": false,
                "pageLength": 10,
                "order": [[0, 'asc']],
                "language": {
                    "search": "Search documents:",
                    "zeroRecords": "No documents found matching your search",
                    "paginate": {
                        "previous": "<i class='fas fa-chevron-left'></i>",
                        "next": "<i class='fas fa-chevron-right'></i>"
                    }
                }
            });
        });
    </script>

    <!-- Optional: Include DataTables for enhanced table features -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.11.5/css/dataTables.bootstrap5.min.css" />
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap5.min.js"></script>
}