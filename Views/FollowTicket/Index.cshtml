@model ShareIT.Models.ViewModel.TicketDetailsViewModel
@using System.IO;
@{
    ViewData["Title"] = $"Ticket Data - {Model.Ticket.RefNo}";
    Layout = "~/Views/Shared/_Admin.cshtml";
    var activeTab = ViewBag.ActiveTab ?? "main";
    var ticket = Model.Ticket;
    var reporter = ticket.Reporter;
    var isAnonymous = reporter?.reporterType == "Anonymous";
}

<style>
    :root {
        --primary-red: #c4252a;
        --primary-black: #302e2d;
        --dark-red: #a61e23;
        --light-gray: #f8f9fa;
        --shadow: 0 4px 12px rgba(0, 0, 0, 0.08);
        --transition: all 0.3s ease;
    }

    /* Navigation Icons */
    .nav-icons {
        display: flex;
        justify-content: space-around;
        padding: 20px;
        background: white;
        border-radius: 12px;
        box-shadow: var(--shadow);
        margin-bottom: 25px;
        flex-wrap: wrap;
    }

    .nav-icon-item {
        text-align: center;
        cursor: pointer;
        padding: 15px 20px;
        border-radius: 10px;
        transition: var(--transition);
    }

        .nav-icon-item:hover {
            background: rgba(196, 37, 42, 0.1);
            transform: translateY(-3px);
        }

        .nav-icon-item.active {
            background: linear-gradient(135deg, var(--primary-red), var(--dark-red));
            color: white;
        }

        .nav-icon-item i {
            font-size: 28px;
            margin-bottom: 8px;
        }

        .nav-icon-item span {
            display: block;
            font-size: 12px;
            font-weight: 500;
        }

        .nav-icon-item .badge {
            position: absolute;
            top: 5px;
            right: 5px;
        }

    /* Cards */
    .info-card {
        background: white;
        border-radius: 12px;
        box-shadow: var(--shadow);
        padding: 25px;
        margin-bottom: 25px;
        transition: var(--transition);
    }

        .info-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.12);
        }

    .card-header-custom {
        background: linear-gradient(135deg, var(--primary-red), var(--dark-red));
        color: white;
        padding: 15px 20px;
        border-radius: 12px 12px 0 0;
        margin: -25px -25px 20px -25px;
    }

        .card-header-custom h6 {
            margin: 0;
            font-weight: 600;
        }

    /* Info Rows */
    .info-row {
        display: flex;
        margin-bottom: 15px;
        padding-bottom: 15px;
        border-bottom: 1px solid #f0f0f0;
    }

        .info-row:last-child {
            border-bottom: none;
            margin-bottom: 0;
            padding-bottom: 0;
        }

    .info-label {
        width: 200px;
        font-weight: 600;
        color: #6c757d;
    }

    .info-value {
        flex: 1;
        color: #343a40;
    }

    /* Comment Bubbles */
    .comment-thread {
        max-height: 500px;
        overflow-y: auto;
        padding: 15px;
        background: #f8f9fa;
        border-radius: 12px;
    }

    .comment-item {
        display: flex;
        margin-bottom: 20px;
        animation: fadeIn 0.3s ease;
    }

    .comment-avatar {
        width: 50px;
        height: 50px;
        margin-right: 15px;
        flex-shrink: 0;
    }

        .comment-avatar img {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            border: 3px solid white;
            box-shadow: var(--shadow);
        }

    .comment-content {
        flex: 1;
        background: white;
        border-radius: 12px;
        padding: 15px;
        position: relative;
        box-shadow: var(--shadow);
    }

        .comment-content::before {
            content: '';
            position: absolute;
            left: -10px;
            top: 15px;
            border-width: 10px 10px 10px 0;
            border-style: solid;
            border-color: transparent white transparent transparent;
        }

    .admin-comment .comment-content {
        background: linear-gradient(135deg, var(--primary-red), var(--dark-red));
        color: white;
    }

        .admin-comment .comment-content::before {
            border-color: transparent var(--primary-red) transparent transparent;
        }

        .admin-comment .comment-content .comment-author,
        .admin-comment .comment-content .comment-date {
            color: rgba(255, 255, 255, 0.9);
        }

        .admin-comment .comment-content .comment-text {
            color: white;
        }

    .comment-header {
        display: flex;
        justify-content: space-between;
        margin-bottom: 10px;
    }

    .comment-author {
        font-weight: 600;
        color: var(--primary-red);
    }

    .comment-date {
        color: #6c757d;
        font-size: 12px;
    }

    .comment-text {
        color: #343a40;
        line-height: 1.5;
        margin: 0;
        white-space: pre-wrap;
    }

    /* File Grid */
    .file-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 15px;
        margin-top: 20px;
    }

    .file-item {
        background: white;
        border: 1px solid #e0e0e0;
        border-radius: 10px;
        padding: 15px;
        display: flex;
        align-items: center;
        transition: var(--transition);
    }

        .file-item:hover {
            border-color: var(--primary-red);
            transform: translateY(-2px);
            box-shadow: var(--shadow);
        }

    .file-icon {
        width: 40px;
        height: 40px;
        background: rgba(196, 37, 42, 0.1);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 12px;
        color: var(--primary-red);
        font-size: 18px;
    }

    .file-info {
        flex: 1;
        min-width: 0;
    }

    .file-name {
        font-size: 14px;
        font-weight: 500;
        color: #343a40;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin-bottom: 4px;
    }

    .file-size {
        font-size: 11px;
        color: #6c757d;
    }

    .file-actions {
        display: flex;
        gap: 5px;
    }

    .btn-file {
        width: 32px;
        height: 32px;
        border-radius: 6px;
        border: 1px solid #e0e0e0;
        background: white;
        color: #6c757d;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: var(--transition);
    }

        .btn-file:hover {
            background: var(--primary-red);
            color: white;
            border-color: var(--primary-red);
        }

    /* Audio Player */
    audio {
        width: 100%;
        margin-top: 10px;
    }

    /* Status Badge */
    .status-badge {
        display: inline-block;
        padding: 8px 20px;
        border-radius: 25px;
        font-size: 14px;
        font-weight: 600;
    }

    .status-open {
        background: #28a745;
        color: white;
    }

    .status-investigation {
        background: #ffc107;
        color: #212529;
    }

    .status-closed {
        background: #6c757d;
        color: white;
    }

    /* Form Styles */
    .form-section {
        background: #f8f9fa;
        border-radius: 12px;
        padding: 25px;
        margin-top: 20px;
    }

    .form-control, .form-select {
        border: 2px solid #e9ecef;
        border-radius: 8px;
        padding: 12px 15px;
        transition: var(--transition);
    }

        .form-control:focus, .form-select:focus {
            border-color: var(--primary-red);
            box-shadow: 0 0 0 0.2rem rgba(196, 37, 42, 0.25);
        }

    .btn-custom-primary {
        background: linear-gradient(135deg, var(--primary-red), var(--dark-red));
        color: white;
        border: none;
        padding: 12px 30px;
        border-radius: 8px;
        font-weight: 500;
        transition: var(--transition);
    }

        .btn-custom-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(196, 37, 42, 0.3);
        }

    .btn-custom-secondary {
        background: white;
        color: var(--primary-red);
        border: 1px solid var(--primary-red);
        padding: 12px 30px;
        border-radius: 8px;
        font-weight: 500;
        transition: var(--transition);
    }

        .btn-custom-secondary:hover {
            background: var(--primary-red);
            color: white;
        }

    /* Timeline */
    .timeline {
        position: relative;
        padding-left: 30px;
    }

        .timeline::before {
            content: '';
            position: absolute;
            left: 15px;
            top: 0;
            bottom: 0;
            width: 2px;
            background: linear-gradient(to bottom, var(--primary-red), #6c757d);
        }

    .timeline-item {
        position: relative;
        margin-bottom: 25px;
        display: flex;
        align-items: flex-start;
    }

    .timeline-icon {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        position: absolute;
        left: -38px;
        top: 0;
        font-size: 12px;
        border: 3px solid white;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .timeline-content {
        flex: 1;
        background: white;
        border: 1px solid #e9ecef;
        border-radius: 8px;
        padding: 15px;
    }

    /* Animation */
    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .nav-icons {
            gap: 10px;
        }

        .nav-icon-item {
            flex: 1 0 calc(33.333% - 10px);
            padding: 10px;
        }

        .info-row {
            flex-direction: column;
        }

        .info-label {
            width: 100%;
            margin-bottom: 5px;
        }

        .file-grid {
            grid-template-columns: 1fr;
        }
    }

    /* Forwarding Info */
    .forwarding-info {
        background: #e7f3ff;
        border-left: 4px solid #0d6efd;
        padding: 15px;
        border-radius: 8px;
        margin-bottom: 20px;
    }

    /* Loading Spinner */
    .spinner-border-sm {
        width: 1rem;
        height: 1rem;
        border-width: 0.2em;
    }
</style>

<!-- Page Header -->
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 mb-0 text-gray-800">
            <i class="fas fa-clipboard-list me-2"></i>
            Case Data - <span style="color: var(--primary-red);">@ticket.RefNo</span>
        </h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item"><a asp-controller="Ticket" asp-action="Index">All Cases</a></li>
                <li class="breadcrumb-item active">Case Details</li>
            </ol>
        </nav>
    </div>
    @* <div>
        @{
            var statusClass = ticket.ComStatusId == 1 ? "status-open" :
            ticket.ComStatusId == 2 ? "status-investigation" :
            "status-closed";
            var statusText = ticket.ComStatusId == 1 ? "Open" :
            ticket.ComStatusId == 2 ? "Under Investigation" :
            "Closed";
        }
        <span class="status-badge @statusClass">
            <i class="fas fa-circle me-1"></i>
            @statusText
        </span>
    </div> *@
</div>

<!-- Alerts -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Navigation Icons -->
<div class="nav-icons">
    <div class="nav-icon-item @(activeTab == "main" ? "active" : "")"
         onclick="location.href='@Url.Action("Index", new { id = ticket.Id, activeTab = "main" })'">
        <i class="fas fa-database"></i>
        <span>Main Data</span>
    </div>
    <div class="nav-icon-item @(activeTab == "attachment" ? "active" : "")"
         onclick="location.href='@Url.Action("Index", new { id = ticket.Id, activeTab = "attachment" })'">
        <i class="fas fa-paperclip"></i>
        <span>Attachments</span>
        @if (Model.Attachments?.Any() == true)
        {
            <span class="badge bg-danger">@Model.Attachments.Count</span>
        }
    </div>
    <div class="nav-icon-item @(activeTab == "chats" ? "active" : "")"
         onclick="location.href='@Url.Action("Index", new { id = ticket.Id, activeTab = "chats" })'">
        <i class="fas fa-comments"></i>
        <span>Chats</span>
        @if (Model.RecentMessages?.Any() == true)
        {
            <span class="badge bg-danger">@Model.RecentMessages.Count</span>
        }
    </div>
    <div class="nav-icon-item @(activeTab == "internal" ? "active" : "")"
         onclick="location.href='@Url.Action("Index", new { id = ticket.Id, activeTab = "internal" })'">
        <i class="fas fa-lock"></i>
        <span>Internal</span>
    </div>
    <div class="nav-icon-item @(activeTab == "final" ? "active" : "")"
         onclick="location.href='@Url.Action("Index", new { id = ticket.Id, activeTab = "final" })'">
        <i class="fas fa-check-circle"></i>
        <span>Resolution</span>
    </div>
    <div class="nav-icon-item @(activeTab == "forward" ? "active" : "")"
         onclick="location.href='@Url.Action("Index", new { id = ticket.Id, activeTab = "forward" })'">
        <i class="fas fa-share"></i>
        <span>Assign</span>
    </div>
</div>

<!-- MAIN DATA TAB -->
@if (activeTab == "main")
{
    <!-- Reporter Data -->
    <div class="info-card">
        <div class="card-header-custom">
            <h6><i class="fas fa-user me-2"></i> Reporter Data</h6>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="info-row">
                    <div class="info-label">Reporter Type:</div>
                    <div class="info-value">
                        @if (isAnonymous)
                        {
                            <span class="badge bg-secondary">I wish to remain anonymous</span>
                        }
                        else
                        {
                            <span class="badge bg-success">I wish to disclose my identity</span>
                        }
                    </div>
                </div>
                <div class="info-row">
                    <div class="info-label">ELSEWEDY Employee?:</div>
                    <div class="info-value">
                        @if (!isAnonymous)
                        {
                            @(reporter?.RelationId == 0 ? "Yes" : "No")
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </div>
                </div>
                <div class="info-row">
                    <div class="info-label">Name:</div>
                    <div class="info-value">
                        @if (!isAnonymous)
                        {
                            @reporter?.name
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </div>
                </div>
                <div class="info-row">
                    <div class="info-label">Company:</div>
                    <div class="info-value">
                      @*   @if (!isAnonymous)
                        {
                            @reporter?.c
                        }
                        else
                        {
                            <span>-</span>
                        } *@
                    </div>
                </div>
               @*  <div class="info-row">
                    <div class="info-label">Department:</div>
                    <div class="info-value">
                        @if (!isAnonymous)
                        {
                            @reporter?.Department.Name
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </div>
                </div> *@
            </div>
            <div class="col-md-6">
                <div class="info-row">
                    <div class="info-label">Relationship:</div>
                    <div class="info-value">
                        @if (!isAnonymous)
                        {
                            @(reporter?.RelationId == 0 ? "-" : reporter?.RelationId)
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </div>
                </div>
                <div class="info-row">
                    <div class="info-label">Mobile:</div>
                    <div class="info-value">
                        @if (!isAnonymous)
                        {
                            @reporter?.mobile
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </div>
                </div>
                <div class="info-row">
                    <div class="info-label">Email 1:</div>
                    <div class="info-value">
                        @if (!isAnonymous)
                        {
                            <a href="mailto:@reporter?.email1">@reporter?.email1</a>
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </div>
                </div>
                <div class="info-row">
                    <div class="info-label">Email 2:</div>
                    <div class="info-value">
                        @if (!isAnonymous && !string.IsNullOrEmpty(reporter?.email2))
                        {
                            <a href="mailto:@reporter?.email2">@reporter?.email2</a>
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Ticket Data -->
    <div class="info-card">
        <div class="card-header-custom">
            <h6><i class="fas fa-file-alt me-2"></i> Case Data</h6>
        </div>
        <form asp-action="UpdateTicketData" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ticketId" value="@ticket.Id" />

            <div class="row">
                <div class="col-md-6">

                    <!-- Ticket Type Dropdown -->
                    <div class="info-row">
                        <div class="info-label">Case Type:</div>
                        <div class="info-value">
                            <select name="ticketTypeId" class="form-select form-select-sm">
                                <option value="">-- Select Type --</option>
                                @foreach (var type in ViewBag.Categories as List<Category> ?? new List<Category>())
                                {
                                    <option value="@type.Id"
                                            selected="@(ticket.CategoryId == type.Id)">
                                        @type.ComplainType
                                    </option>
                                }
                            </select>
                        </div>
                    </div>

                    <!-- Concerning Company -->
                    <div class="info-row">
                        <div class="info-label">Regarding Company:</div>
                        <div class="info-value">
                            <select name="concerningCompany" class="form-select form-select-sm" id="ddlConcerningCompany">
                                <option value="">-- Select Company --</option>
                                @foreach (var company in ViewBag.Company as List<Company> ?? new List<Company>())
                                {
                                    <option value="@company.Name"
                                            selected="@(ticket.ConcerningCompany == company.Name)">
                                        @company.Name
                                    </option>
                                }
                            </select>
                        </div>
                    </div>

                    <!-- Concerning Department -->
                    <div class="info-row">
                        <div class="info-label">Regarding Department:</div>
                        <div class="info-value">
                            <select name="concerningDepartment" class="form-select form-select-sm" id="ddlConcerningDepartment">
                                <option value="">-- Select Department --</option>
                                @foreach (var dept in ViewBag.Department as List<Department> ?? new List<Department>())
                                {
                                    <option value="@dept.Name"
                                            selected="@(ticket.ConcerningDepartment == dept.Name)">
                                        @dept.Name
                                    </option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">

                    <!-- Concerning Person -->
                    <div class="info-row">
                        <div class="info-label">Regarding Person:</div>
                        <div class="info-value">
                            <input type="text"
                                   name="concerningPerson"
                                   class="form-control form-control-sm"
                                   value="@ticket.ConcerningPerson"
                                   placeholder="Enter person name..." />
                        </div>
                    </div>

                    <!-- Concerning Other -->
                    <div class="info-row">
                        <div class="info-label">Other:</div>
                        <div class="info-value">
                            <input type="text"
                                   name="concerningOther"
                                   class="form-control form-control-sm"
                                   value="@ticket.ConcerningOther"
                                   placeholder="Enter other details..." />
                        </div>
                    </div>

                    <!-- Language (read-only) -->
                    <div class="info-row">
                        <div class="info-label">Language:</div>
                        <div class="info-value">
                            <span class="badge @(ticket.langFlag == "A" ? "bg-success" : "bg-primary")">
                                <i class="fas @(ticket.langFlag == "A" ? "fa-globe-africa" : "fa-globe-americas") me-1"></i>
                                @(ticket.langFlag == "A" ? "Arabic" : "English")
                            </span>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Description (read-only - submitted by reporter) -->
            <div class="row mt-3">
                <div class="col-12">
                    <div class="info-row">
                        <div class="info-label">Description:</div>
                        <div class="info-value">
                            <div class="p-3 bg-light rounded">
                                @Html.Raw(ticket.Desc?.Replace("\n", "<br/>"))
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Save Button -->
            <div class="row mt-3">
                <div class="col-12 text-end">
                    <button type="submit" class="btn-custom-primary">
                        <i class="fas fa-save me-2"></i>Save Changes
                    </button>
                </div>
            </div>

        </form>
    </div>

    <!-- Timeline -->
    <div class="info-card">
        <div class="card-header-custom">
            <h6><i class="fas fa-history me-2"></i> Timeline</h6>
        </div>
        <div class="card-body">
            @if (Model.Timeline?.Any() == true)
            {
                <div class="timeline">
                    @foreach (var item in Model.Timeline.OrderByDescending(t => t.Date))
                    {
                        <div class="timeline-item">
                            <div class="timeline-icon bg-@item.Color">
                                <i class="@item.Icon"></i>
                            </div>
                            <div class="timeline-content">
                                <h6 class="mb-1">@item.Title</h6>
                                <p class="small text-muted mb-1">@item.Description</p>
                                <small class="text-muted">
                                    <i class="far fa-clock me-1"></i>@item.TimeAgo
                                    <span class="mx-2">•</span>
                                    @item.Date.ToString("dd/MM/yyyy HH:mm")
                                </small>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-history fa-3x text-muted mb-3"></i>
                    <p class="text-muted">No timeline events available</p>
                </div>
            }
        </div>
    </div>
}

<!-- ATTACHMENT TAB -->
@if (activeTab == "attachment")
{
    <div class="info-card">
        <div class="card-header-custom">
            <h6><i class="fas fa-paperclip me-2"></i> Attachments</h6>
        </div>
        <div class="card-body">
            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i>
                Allowed files: <strong>DOCX, PDF, DOC, WAV, MP3, JPG, PNG, MSG</strong> only
            </div>

            <!-- Upload Form -->
            <form asp-action="UploadAttachment" method="post" enctype="multipart/form-data" class="form-section">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ticketId" value="@ticket.Id" />

                <div class="row align-items-end">
                    <div class="col-md-8">
                        <div class="form-group">
                            <label class="form-label fw-bold">Select File:</label>
                            <input type="file" name="file" class="form-control"
                                   accept=".docx,.pdf,.doc,.wav,.mp3,.jpg,.png,.msg" required
                                   onchange="previewFileName(this)" />
                            <small class="text-muted file-name-preview"></small>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn-custom-primary w-100" id="uploadBtn">
                            <i class="fas fa-upload me-2"></i>Upload
                        </button>
                    </div>
                </div>
            </form>

            @{
                var audioFiles = Model.Attachments?.Where(a =>
                a.filePath != null && (
                a.filePath.EndsWith(".wav", StringComparison.OrdinalIgnoreCase) ||
                a.filePath.EndsWith(".mp3", StringComparison.OrdinalIgnoreCase))).ToList();
                var docFiles = Model.Attachments?.Where(a =>
                a.filePath != null &&
                !a.filePath.EndsWith(".wav", StringComparison.OrdinalIgnoreCase) &&
                !a.filePath.EndsWith(".mp3", StringComparison.OrdinalIgnoreCase)).ToList();
            }

            <!-- Audio Files -->
            @if (audioFiles?.Any() == true)
            {
                <h6 class="mt-4 mb-3">
                    <i class="fas fa-headphones me-2"></i> Audio Recordings
                    <span class="badge bg-secondary">@audioFiles.Count</span>
                </h6>
                <div class="file-grid">
                    @foreach (var file in audioFiles)
                    {
                        <div class="file-item">
                            <div class="file-icon">
                                <i class="fas fa-music"></i>
                            </div>
                            <div class="file-info">
                            
                                <audio controls>
                                    <source src="@file.filePath" type="audio/mpeg">
                                </audio>
                            </div>
                            <div class="file-actions">
                                <a href="@Url.Action("DownloadFile", "FollowTicket", new { filePath = file.filePath })"
                                   class="btn-file" title="Download" target="_blank">
                                    <i class="fas fa-download"></i>
                                </a>
                                <button type="button" class="btn-file"
                                        onclick="deleteFile('@file.filePath', @ticket.Id, false)"
                                        title="Delete">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }

            <!-- Document Files -->
            @if (docFiles?.Any() == true)
            {
                <h6 class="mt-4 mb-3">
                    <i class="fas fa-file-alt me-2"></i> Documents
                    <span class="badge bg-secondary">@docFiles.Count</span>
                </h6>
                <div class="file-grid">
                    @foreach (var file in docFiles)
                    {
                        <div class="file-item">
                            <div class="file-icon">
                                <i class="fas @GetFileIcon(file.filePath)"></i>
                            </div>
                      
                            <div class="file-actions">
                                <a href="@Url.Action("DownloadFile", "FollowTicket", new { filePath = file.filePath })"
                                   class="btn-file" title="Download" target="_blank">
                                    <i class="fas fa-download"></i>
                                </a>
                                <button type="button" class="btn-file"
                                        onclick="deleteFile('@file.filePath', @ticket.Id, false)"
                                        title="Delete">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }

            @if (Model.Attachments?.Any() != true)
            {
                <div class="text-center py-5">
                    <i class="fas fa-file-alt fa-3x text-muted mb-3"></i>
                    <p class="text-muted">No files uploaded yet.</p>
                </div>
            }
        </div>
    </div>
}

