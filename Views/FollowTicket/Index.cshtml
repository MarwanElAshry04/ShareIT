@functions {
    public string GetFileIcon(string filePath)
    {
        if (string.IsNullOrEmpty(filePath))
            return "fa-file-alt";

        var extension = System.IO.Path.GetExtension(filePath)?.ToLower();
        return extension switch
        {
            ".pdf" => "fa-file-pdf",
            ".doc" or ".docx" => "fa-file-word",
            ".xls" or ".xlsx" => "fa-file-excel",
            ".jpg" or ".jpeg" or ".png" or ".gif" => "fa-file-image",
            ".wav" or ".mp3" or ".m4a" => "fa-file-audio",
            ".msg" => "fa-envelope",
            _ => "fa-file-alt"
        };
    }
}
@section Scripts {
    <script>
        $(document).ready(function() {
            // Handle status dropdown change
            $('#ddlStatus').change(function() {
                if ($(this).val() === '3') { // Closed
                    $('#rowValidation').slideDown();
                } else {
                    $('#rowValidation').slideUp();
                    $('#rowValidation select').val('');
                }
            });

            // Auto-hide alerts after 5 seconds
            setTimeout(function() {
                $('.alert').fadeOut(500);
            }, 5000);

            // Confirm delete
            window.deleteFile = function(filePath, ticketId, isInternal) {
                if (confirm('Are you sure you want to delete this file?')) {
                    $.ajax({
                        url: '@Url.Action("DeleteAttachment", "FollowTicket")',
                        type: 'POST',
                        data: {
                            filePath: filePath,
                            ticketId: ticketId,
                            isInternal: isInternal,
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function(response) {
                            if (response.success) {
                                location.reload();
                            } else {
                                alert('Error deleting file: ' + (response.error || 'Unknown error'));
                            }
                        },
                        error: function(xhr, status, error) {
                            alert('Error deleting file: ' + error);
                        }
                    });
                }
                return false;
            };

            // Check for new messages every 30 seconds
            @if (activeTab == "chats")
            {
                    <text>
                    setInterval(function() {
                        if (document.hasFocus()) {
                            $.ajax({
                                url: '@Url.Action("GetUnreadCount", "FollowTicket")',
                                data: { ticketId: @ticket.Id },
                                success: function(count) {
                                    if (count > 0) {
                                        $('.nav-icon-item:eq(2) .badge').text(count).show();
                                    }
                                }
                            });
                        }
                    }, 30000);
                    </text>
            }
        });

        // Ctrl+Enter to submit form
        window.handleCtrlEnter = function(event, textarea) {
            if (event.ctrlKey && event.keyCode === 13) {
                event.preventDefault();
                $(textarea).closest('form').submit();
            }
        };

        // Preview file name
        window.previewFileName = function(input) {
            if (input.files && input.files[0]) {
                var fileName = input.files[0].name;
                var fileSize = (input.files[0].size / 1024).toFixed(2) + ' KB';
                $(input).closest('.row').find('.btn-custom-primary').html('<i class="fas fa-upload me-2"></i>Upload ' + fileName);
                $(input).closest('.row').find('.file-name-preview').text('Selected: ' + fileName + ' (' + fileSize + ')');
            }
        };

        // Form submission loading state
        $('form').submit(function() {
            var btn = $(this).find('button[type="submit"]');
            btn.html('<span class="spinner-border spinner-border-sm me-2" role="status"></span>Processing...');
            btn.prop('disabled', true);
        });

        // Auto-resize textarea
        $('textarea').each(function() {
            this.style.height = 'auto';
            this.style.height = (this.scrollHeight) + 'px';
        }).on('input', function() {
            this.style.height = 'auto';
            this.style.height = (this.scrollHeight) + 'px';
        });
    </script>
}

