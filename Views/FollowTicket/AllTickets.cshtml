@using ShareIT.Models.ViewModel
@model ShareIT.Models.ViewModel.TicketListViewModel
@{
    ViewData["Title"] = "All Tickets - Admin Panel";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

<style>
    :root {
        --primary-red: #c4252a;
        --primary-black: #302e2d;
        --dark-red: #a61e23;
        --light-gray: #f8f9fa;
        --shadow: 0 4px 12px rgba(0, 0, 0, 0.08);
        --transition: all 0.3s ease;
    }

    /* Stats Cards */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: white;
        border-radius: 12px;
        padding: 20px;
        box-shadow: var(--shadow);
        transition: var(--transition);
        position: relative;
        overflow: hidden;
    }

        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.12);
        }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 4px;
            height: 100%;
            background: linear-gradient(135deg, var(--primary-red), var(--dark-red));
        }

    .stat-icon {
        width: 48px;
        height: 48px;
        background: rgba(196, 37, 42, 0.1);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--primary-red);
        font-size: 20px;
        margin-bottom: 15px;
    }

    .stat-value {
        font-size: 28px;
        font-weight: 700;
        color: var(--primary-black);
        margin-bottom: 5px;
    }

    .stat-label {
        color: #6c757d;
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* Filter Card */
    .filter-card {
        background: white;
        border-radius: 12px;
        padding: 25px;
        margin-bottom: 25px;
        box-shadow: var(--shadow);
    }

    .filter-title {
        color: var(--primary-red);
        font-weight: 600;
        margin-bottom: 20px;
        padding-bottom: 10px;
        border-bottom: 2px solid #f0f0f0;
    }

    .filter-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
    }

    .filter-group {
        display: flex;
        flex-direction: column;
    }

    .filter-label {
        font-weight: 600;
        color: #495057;
        margin-bottom: 8px;
        font-size: 13px;
    }

    .filter-control {
        width: 100%;
        padding: 10px 15px;
        border: 2px solid #e9ecef;
        border-radius: 8px;
        transition: var(--transition);
        font-size: 14px;
    }

        .filter-control:focus {
            border-color: var(--primary-red);
            box-shadow: 0 0 0 0.2rem rgba(196, 37, 42, 0.25);
            outline: none;
        }

    .filter-actions {
        display: flex;
        gap: 10px;
        align-items: flex-end;
        margin-top: 20px;
    }

    .btn-filter {
        background: linear-gradient(135deg, var(--primary-red), var(--dark-red));
        color: white;
        border: none;
        padding: 10px 25px;
        border-radius: 8px;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: var(--transition);
    }

        .btn-filter:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(196, 37, 42, 0.3);
            color: white;
        }

    .btn-reset {
        background: white;
        color: var(--primary-red);
        border: 1px solid var(--primary-red);
        padding: 10px 25px;
        border-radius: 8px;
        font-weight: 500;
        transition: var(--transition);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-reset:hover {
            background: var(--primary-red);
            color: white;
        }

    .btn-export {
        background: #28a745;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: var(--transition);
        margin-left: auto;
    }

        .btn-export:hover {
            background: #218838;
            transform: translateY(-2px);
            color: white;
        }

    /* Quick Actions */
    .quick-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 25px;
    }

    .quick-action-btn {
        background: white;
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        padding: 10px 20px;
        display: flex;
        align-items: center;
        gap: 10px;
        transition: var(--transition);
        color: #495057;
        text-decoration: none;
        font-size: 14px;
    }

        .quick-action-btn:hover {
            border-color: var(--primary-red);
            color: var(--primary-red);
            background: rgba(196, 37, 42, 0.05);
            text-decoration: none;
        }

        .quick-action-btn.active {
            background: var(--primary-red);
            color: white;
            border-color: var(--primary-red);
        }

    /* Table */
    .table-container {
        background: white;
        border-radius: 12px;
        box-shadow: var(--shadow);
        overflow: hidden;
        margin-top: 25px;
    }

    .table-header {
        padding: 20px;
        background: linear-gradient(135deg, var(--primary-black), #1a1a1a);
        color: white;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
    }

    .table-title {
        font-size: 18px;
        font-weight: 600;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .table-actions {
        display: flex;
        gap: 10px;
    }

    .table-responsive {
        overflow-x: auto;
    }

    .table {
        margin: 0;
        width: 100%;
    }

        .table thead th {
            background: #f8f9fa;
            color: var(--primary-black);
            font-weight: 600;
            padding: 15px;
            border-bottom: 2px solid var(--primary-red);
            white-space: nowrap;
        }

        .table tbody td {
            padding: 15px;
            vertical-align: middle;
            border-bottom: 1px solid #f0f0f0;
        }

        .table tbody tr {
            transition: var(--transition);
        }

            .table tbody tr:hover {
                background: rgba(196, 37, 42, 0.05);
                cursor: pointer;
            }

    .ref-number {
        font-weight: 700;
        color: var(--primary-red);
        text-decoration: none;
    }

        .ref-number:hover {
            text-decoration: underline;
        }

    /* Status Badges */
    .status-badge {
        display: inline-block;
        padding: 6px 15px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        text-align: center;
        min-width: 120px;
    }

    .status-open {
        background: #d4edda;
        color: #155724;
        border: 1px solid #c3e6cb;
    }

    .status-pending {
        background: #fff3cd;
        color: #856404;
        border: 1px solid #ffeeba;
    }

    .status-investigation {
        background: #cce5ff;
        color: #004085;
        border: 1px solid #b8daff;
    }

    .status-resolved {
        background: #d1ecf1;
        color: #0c5460;
        border: 1px solid #bee5eb;
    }

    .status-closed {
        background: #e2e3e5;
        color: #383d41;
        border: 1px solid #d6d8db;
    }

    .status-valid {
        background: #d4edda;
        color: #155724;
        border: 1px solid #c3e6cb;
    }

    .status-invalid {
        background: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
    }

    .status-default {
        background: #e2e3e5;
        color: #383d41;
        border: 1px solid #d6d8db;
    }

    /* Priority Badges */
    .priority-badge {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 12px;
        font-size: 11px;
        font-weight: 600;
        min-width: 70px;
        text-align: center;
    }

    .priority-high {
        background: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
    }

    .priority-medium {
        background: #fff3cd;
        color: #856404;
        border: 1px solid #ffeeba;
    }

    .priority-low {
        background: #d1ecf1;
        color: #0c5460;
        border: 1px solid #bee5eb;
    }

    /* Action Buttons */
    .btn-action {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        border: 1px solid #e0e0e0;
        background: white;
        color: #6c757d;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: var(--transition);
        margin: 0 3px;
    }

        .btn-action:hover {
            background: var(--primary-red);
            color: white;
            border-color: var(--primary-red);
            transform: translateY(-2px);
        }

    /* Pagination */
    .pagination-container {
        padding: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        background: #f8f9fa;
        border-top: 1px solid #dee2e6;
    }

    .pagination-info {
        color: #6c757d;
        font-size: 14px;
    }

    .pagination {
        margin: 0;
        gap: 5px;
    }

    .page-link {
        border: 1px solid #e0e0e0;
        border-radius: 6px;
        color: #6c757d;
        padding: 8px 14px;
        transition: var(--transition);
    }

        .page-link:hover {
            background: var(--primary-red);
            color: white;
            border-color: var(--primary-red);
        }

    .page-item.active .page-link {
        background: var(--primary-red);
        color: white;
        border-color: var(--primary-red);
    }

    .page-item.disabled .page-link {
        background: #e9ecef;
        color: #adb5bd;
        pointer-events: none;
    }

    /* Empty State */
    .empty-state {
        text-align: center;
        padding: 60px 20px;
    }

        .empty-state i {
            font-size: 48px;
            color: #e0e0e0;
            margin-bottom: 20px;
        }

        .empty-state h4 {
            color: #6c757d;
            margin-bottom: 10px;
        }

        .empty-state p {
            color: #adb5bd;
            margin-bottom: 20px;
        }

    /* Loading Spinner */
    .loading-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(255,255,255,0.8);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        display: none;
    }

    .spinner-border-sm {
        width: 1rem;
        height: 1rem;
        border-width: 0.2em;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .stats-grid {
            grid-template-columns: 1fr;
        }

        .filter-grid {
            grid-template-columns: 1fr;
        }

        .table-header {
            flex-direction: column;
            gap: 15px;
            align-items: flex-start;
        }

        .table-actions {
            width: 100%;
        }

        .pagination-container {
            flex-direction: column;
            gap: 15px;
            align-items: flex-start;
        }

        .quick-actions {
            justify-content: flex-start;
        }

        .quick-action-btn {
            flex: 0 0 auto;
        }
    }
</style>

<!-- Loading Overlay -->
<div class="loading-overlay" id="loadingOverlay">
    <div class="spinner-border text-danger" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
</div>

<!-- Statistics Cards -->
<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-icon">
            <i class="fas fa-folder-open"></i>
        </div>
        <div class="stat-value">@Model.Statistics.TotalTickets</div>
        <div class="stat-label">Total Tickets</div>
    </div>

    <div class="stat-card">
        <div class="stat-icon">
            <i class="fas fa-clock"></i>
        </div>
        <div class="stat-value">@Model.Statistics.Initiate</div>
        <div class="stat-label">Initiate</div>
    </div>

    <div class="stat-card">
        <div class="stat-icon">
            <i class="fas fa-search"></i>
        </div>
        <div class="stat-value">@Model.Statistics.InProcess</div>
        <div class="stat-label">In-Process</div>
    </div>

    <div class="stat-card">
        <div class="stat-icon">
            <i class="fas fa-check-circle"></i>
        </div>
        <div class="stat-value">@Model.Statistics.Closed</div>
        <div class="stat-label">Closed/Resolved</div>
    </div>

    <div class="stat-card">
        <div class="stat-icon">
            <i class="fas fa-check"></i>
        </div>
        <div class="stat-value">@Model.Statistics.ValidTickets</div>
        <div class="stat-label">Valid</div>
    </div>

    <div class="stat-card">
        <div class="stat-icon">
            <i class="fas fa-times"></i>
        </div>
        <div class="stat-value">@Model.Statistics.InvalidTickets</div>
        <div class="stat-label">Invalid</div>
    </div>
</div>

<!-- Charts Row -->
<div class="row mb-4">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h6 class="mb-">
                    <i class="fas fa-chart-line me-2"></i>
                    Monthly Trends
                </h6>
            </div>
            <div class="card-body">
                <canvas id="monthlyChart" height="250"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h6 class="mb-0 ">
                    <i class="fas fa-chart-pie me-2"></i>
                    Type Distribution
                </h6>
            </div>
            <div class="card-body">
                <canvas id="typeChart" height="250"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Filter Card -->
<div class="filter-card">
    <h5 class="filter-title">
        <i class="fas fa-filter me-2"></i>
        Filter Tickets
    </h5>

    <form asp-action="AllTickets" method="get" id="filterForm">
        <div class="filter-grid">
            <!-- Search -->
            <div class="filter-group">
                <div class="filter-label">
                    <i class="fas fa-search me-1"></i> Search
                </div>
                <input type="text" name="searchTerm" value="@Model.SearchTerm"
                       class="filter-control" placeholder="Ref No, Description, Reporter...">
            </div>

            <!-- Status Filter -->
            <div class="filter-group">
                <div class="filter-label">
                    <i class="fas fa-tag me-1"></i> Status
                </div>
                <select name="status" class="filter-control">
                    <option value="">All Statuses</option>
                   
                    <option value="Initiate" selected="@(Model.Status == "Initiate")">Initiate</option>
                    <option value="In-Process" selected="@(Model.Status == "In-Process")">In-Process</option>
                    <option value="Closed" selected="@(Model.Status == "Closed")">Closed</option>
                </select>
            </div>

            <!-- Type Filter -->
            <div class="filter-group">
                <div class="filter-label">
                    <i class="fas fa-tags me-1"></i> Type
                </div>
                <select name="kind" class="filter-control">
                    <option value="">All Types</option>
                    <option value="Issue" selected="@(Model.TicketType == "Issue")">Issue</option>
                    <option value="Idea" selected="@(Model.TicketType == "Idea")">Idea</option>
                    <option value="ProjectProposal" selected="@(Model.TicketType == "ProjectProposal")">Project Proposal</option>
                    <option value="SafetyConcern" selected="@(Model.TicketType == "SafetyConcern")">Safety Concern</option>
                    <option value="Feedback" selected="@(Model.TicketType == "Feedback")">Feedback</option>
                    <option value="SystemRequest" selected="@(Model.TicketType == "SystemRequest")">System Request</option>
                </select>
            </div>

            @* Old category "Ticket Type" filter (Harassment, etc.) removed — tickets are classified by Type above. *@

        @*     <!-- Priority -->
            <div class="filter-group">
                <div class="filter-label">
                    <i class="fas fa-flag me-1"></i> Priority
                </div>
                <select name="priority" class="filter-control">
                    <option value="">All Priorities</option>
                    @foreach (var priority in Model.Priorities)
                    {
                        <option value="@priority" selected="@(Model.Priority == priority)">
                            @priority
                        </option>
                    }
                </select>
            </div> *@

            <!-- Assigned To -->
            <div class="filter-group">
                <div class="filter-label">
                    <i class="fas fa-user-tie me-1"></i> Assigned To
                </div>
                <select name="assignedTo" class="filter-control">
                    <option value="">All Assignments</option>
                    @if (Model.AssignedDepartments != null)
                    {
                        @foreach (var dept in Model.AssignedDepartments)
                        {
                            <option value="@dept" selected="@(Model.AssignedTo == dept)">
                                @dept
                            </option>
                        }
                    }
                </select>
            </div>

            <!-- Reporter Type -->
            <div class="filter-group">
                <div class="filter-label">
                    <i class="fas fa-user me-1"></i> Reporter Type
                </div>
                <select name="reporterType" class="filter-control">
                    <option value="">All</option>
                    <option value="Disclosed" selected="@(Model.ReporterType == "Disclosed")">Disclosed</option>
                    <option value="Anonymous" selected="@(Model.ReporterType == "Anonymous")">Anonymous</option>
                </select>
            </div>

            <!-- Date From -->
            <div class="filter-group">
                <div class="filter-label">
                    <i class="fas fa-calendar-alt me-1"></i> From Date
                </div>
                <input type="date" name="dateFrom" value="@Model.DateFrom"
                       class="filter-control">
            </div>

            <!-- Date To -->
            <div class="filter-group">
                <div class="filter-label">
                    <i class="fas fa-calendar-alt me-1"></i> To Date
                </div>
                <input type="date" name="dateTo" value="@Model.DateTo"
                       class="filter-control">
            </div>

            <!-- Page Size -->
            <div class="filter-group">
                <div class="filter-label">
                    <i class="fas fa-list me-1"></i> Per Page
                </div>
                <select name="pageSize" class="filter-control">
                    <option value="10" selected="@(Model.PageSize == 10)">10</option>
                    <option value="20" selected="@(Model.PageSize == 20)">20</option>
                    <option value="50" selected="@(Model.PageSize == 50)">50</option>
                    <option value="100" selected="@(Model.PageSize == 100)">100</option>
                </select>
            </div>
        </div>

        <div class="filter-actions">
            <button type="submit" class="btn-filter">
                <i class="fas fa-search me-2"></i> Apply Filters
            </button>
            <a asp-action="AllTickets" class="btn-reset">
                <i class="fas fa-undo me-2"></i> Reset
            </a>
            <a asp-action="ExportTickets"
               asp-route-searchTerm="@Model.SearchTerm"
               asp-route-status="@Model.Status"
               asp-route-typeId="@Model.TypeId"
               asp-route-priority="@Model.Priority"
               asp-route-reporterType="@Model.ReporterType"
               class="btn-export">
                <i class="fas fa-file-csv me-2"></i> Export CSV
            </a>
        </div>
    </form>
</div>

<!-- Quick Actions -->
<div class="quick-actions">
    <a asp-action="AllTickets" class="quick-action-btn @(string.IsNullOrEmpty(Context.Request.Query["status"]) ? "active" : "")">
        <i class="fas fa-list"></i> All
    </a>
    <a asp-action="AllTickets" asp-route-status="Initiate" class="quick-action-btn">
        <i class="fas fa-clock"></i> Initiate
    </a>
    <a asp-action="AllTickets" asp-route-status="In-Process" class="quick-action-btn">
        <i class="fas fa-hourglass-half"></i> In-Process
    </a>
    
    <a asp-action="AllTickets" asp-route-status="Closed" class="quick-action-btn">
        <i class="fas fa-lock"></i> Closed
    </a>
    <a asp-action="AllTickets" asp-route-validation="Valid" class="quick-action-btn">
        <i class="fas fa-check"></i> Valid
    </a>
    <a asp-action="AllTickets" asp-route-validation="Invalid" class="quick-action-btn">
        <i class="fas fa-times"></i> Invalid
    </a>
</div>

<!-- Tickets Table -->
<div class="table-container">
    <div class="table-header">
        <h5 class="table-title">
            <i class="fas fa-list-alt me-2"></i>
            Tickets List
            <span class="badge bg-light text-dark ms-2">@Model.TotalCount</span>
        </h5>
        <div class="table-actions">
            <span class="text-white-50">
                <i class="fas fa-eye me-1"></i>
                Showing @(((Model.CurrentPage - 1) * Model.PageSize) + 1) -
                @Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount)
                of @Model.TotalCount
            </span>
            <button class="btn-filter" onclick="refreshData()">
                <i class="fas fa-sync-alt"></i> Refresh
            </button>
        </div>
    </div>

    <div class="table-responsive">
        @if (Model.Tickets != null && Model.Tickets.Any())
        {
            <table class="table table-hover" id="ticketsTable">
                <thead>
                    <tr>
                        <th width="50">#</th>
                        <th>Reference No</th>
                        <th>Date</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th>Priority</th>
                        <th>Concerning</th>
                        <th>Reporter</th>
                        <th>Assigned To</th>
                        <th>Last Update</th>
                        <th width="100">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int serialNumber = ((Model.CurrentPage - 1) * Model.PageSize) + 1;
                    }
                    @foreach (var ticket in Model.Tickets)
                    {
                        // Status class
                        var statusClass = ticket.validation?.ToLower() switch
                        {
                           @*  "open" => "status-open",
                            "pending" => "status-pending",
                            "investigation" => "status-investigation",
                            "resolved" => "status-resolved",
                            "closed" => "status-closed", *@
                            "Valid" => "status-valid",
                            "Invalid" => "status-invalid",
                            _ => "status-default"
                        };


                        var daysOld = ticket.CreatedOn.HasValue
                        ? (DateTime.Now - ticket.CreatedOn.Value).TotalDays
                        : 0;
                        var isOverdue = 
                        ticket.validation?.ToLower() != "valid" &&
                        ticket.validation?.ToLower() != "invalid" &&
                        daysOld > 7;

                        <tr onclick="window.location.href='@Url.Action("Index", "FollowTicket", new { id = ticket.Id })'" style="cursor: pointer;">
                            <td>
                                <span class="badge bg-secondary">@serialNumber</span>
                                @if (isOverdue)
                                {
                                    <span class="badge bg-danger mt-1" title="Overdue">!</span>
                                }
                            </td>
                            <td>
                                <a href="@Url.Action("Index", "FollowTicket", new { id = ticket.Id })"
                                   class="ref-number" onclick="event.stopPropagation();">
                                    <i class="fas fa-hashtag me-1"></i>@ticket.RefNo
                                </a>
                                @if (ticket.TicketChats != null && ticket.TicketChats.Any(c => c.CreatedOn > DateTime.Now.AddHours(-24)))
                                {
                                    <span class="badge bg-danger ms-1" title="New activity">New</span>
                                }
                        </td>
                        <td>
                            <div>@(ticket.CreatedOn?.ToString("dd/MM/yyyy") ?? "-")</div>
                            <small class="text-muted">@(ticket.CreatedOn?.ToString("HH:mm") ?? "-")</small>
                        </td>
                        <td>
                            @{
                                var kindClass = ticket.TicketType switch
                                {
                                    ShareIT.Models.TicketType.Idea => "bg-primary",
                                    ShareIT.Models.TicketType.Feedback => "bg-success",
                                    _ => "bg-danger"
                                };
                            }
                            <span class="badge @kindClass">@ticket.TicketType</span>
                        </td>
                            <td>
                                <span class="status-badge @statusClass">
                                    <i class="fas fa-circle me-1" style="font-size: 8px;"></i>
                                    @(!string.IsNullOrEmpty(ticket.validation) ? ticket.validation : "Pending")
                                </span>
                            </td>
                           
                            <td>
                                <div>
                                    <strong>
                                        @(ticket.ConcerningCompany?.Length > 20 ?
                                                                        ticket.ConcerningCompany.Substring(0, 20) + "..." :
                                                                        ticket.ConcerningCompany ?? "-")
                                    </strong>
                                </div>
                                <small class="text-muted">
                                    @(ticket.ConcerningDepartment?.Length > 15 ?
                                                                ticket.ConcerningDepartment.Substring(0, 15) + "..." :
                                                                ticket.ConcerningDepartment ?? "-")
                                </small>
                            </td>
                            <td>
                                @if (ticket.Reporter?.reporterType == "Anonymous")
                                {
                                    <span class="badge bg-secondary">
                                        <i class="fas fa-user-secret me-1"></i> Anonymous
                                    </span>
                                }
                                else
                                {
                                    <div>
                                        <i class="fas fa-user me-1 text-muted"></i>
                                        @(ticket.Reporter?.name?.Length > 15 ?
                                                                    ticket.Reporter.name.Substring(0, 15) + "..." :
                                                                    ticket.Reporter?.name ?? "-")
                                    </div>
                                    <small class="text-muted">@ticket.Reporter?.email1</small>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(ticket.forwarding))
                                {
                                    <span class="badge bg-primary">
                                        <i class="fas fa-share me-1"></i>
                                        @(ticket.forwarding.Length > 20 ?
                                                                    ticket.forwarding.Substring(0, 20) + "..." :
                                                                    ticket.forwarding)
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Unassigned</span>
                                }
                            </td>
                            <td>
                                <div>@(ticket.UpdatedOn?.ToString("dd/MM/yyyy") ?? "-")</div>
                                <small class="text-muted">
                                    @((int)daysOld) days old
                                    @if (isOverdue)
                                    {
                                        <span class="text-danger fw-bold">(Overdue)</span>
                                    }
                                </small>
                            </td>
                            <td onclick="event.stopPropagation();">
                                <div class="d-flex">
                                    <a href="@Url.Action("Index", "FollowTicket", new { id = ticket.Id })"
                                       class="btn-action" title="Follow Up">
                                        <i class="fas fa-clipboard-list"></i>
                                    </a>
                                    @if (ticket.TicketAttachments != null && ticket.TicketAttachments.Any())
                                    {
                                        <span class="btn-action" title="Has attachments @(ticket.TicketAttachments.Count()) files">
                                            <i class="fas fa-paperclip"></i>
                                        </span>
                                    }
                                    @if (ticket.TicketChats != null && ticket.TicketChats.Any())
                                    {
                                        <span class="btn-action" title="Has @(ticket.TicketChats.Count()) comments">
                                            <i class="fas fa-comments"></i>
                                        </span>
                                    }
                                    @if (!string.IsNullOrEmpty(ticket.forwarding))
                                    {
                                        <span class="btn-action" title="Assigned to @ticket.forwarding">
                                            <i class="fas fa-share-alt"></i>
                                        </span>
                                    }
                                </div>
                            </td>
                        </tr>
                        serialNumber++;
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-folder-open"></i>
                <h4>No Tickets Found</h4>
                <p>No tickets match your search criteria. Try adjusting your filters.</p>
                <a asp-action="AllTickets" class="btn-filter">
                    <i class="fas fa-undo me-2"></i> Clear Filters
                </a>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="pagination-container">
            <div class="pagination-info">
                <i class="fas fa-file-alt me-1"></i>
                Page @Model.CurrentPage of @Model.TotalPages
                <span class="mx-2">|</span>
                <i class="fas fa-database me-1"></i>
                Total @Model.TotalCount records
            </div>
            <nav>
                <ul class="pagination">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" href="@GetPageUrl(Model.CurrentPage - 1, Model)"
                           aria-label="Previous">
                            <span aria-hidden="true">&laquo;</span>
                        </a>
                    </li>

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        if (i == 1 || i == Model.TotalPages || (i >= Model.CurrentPage - 2 && i <= Model.CurrentPage + 2))
                        {
                            <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                <a class="page-link" href="@GetPageUrl(i, Model)">@i</a>
                            </li>
                        }
                        else if (i == Model.CurrentPage - 3 || i == Model.CurrentPage + 3)
                        {
                            <li class="page-item disabled">
                                <span class="page-link">...</span>
                            </li>
                        }
                    }

                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" href="@GetPageUrl(Model.CurrentPage + 1, Model)"
                           aria-label="Next">
                            <span aria-hidden="true">&raquo;</span>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        $(document).ready(function() {
            // Initialize charts
            initCharts();

            // Auto-refresh data every 5 minutes
            setInterval(refreshData, 300000);
        });

        // Initialize Charts
        function initCharts() {
            // Monthly Trends Chart
            @if (Model.Statistics.MonthlyTrends != null && Model.Statistics.MonthlyTrends.Any())
            {
                    <text>
                    var monthlyCtx = document.getElementById('monthlyChart').getContext('2d');
                    new Chart(monthlyCtx, {
                        type: 'line',
                        data: {
                            labels: @Html.Raw(Json.Serialize(Model.Statistics.MonthlyTrends.Select(m => m.Label))),
                            datasets: [{
                                label: 'Number of Tickets',
                                data: @Html.Raw(Json.Serialize(Model.Statistics.MonthlyTrends.Select(m => m.Value))),
                                borderColor: '#c4252a',
                                backgroundColor: 'rgba(196, 37, 42, 0.1)',
                                borderWidth: 2,
                                pointBackgroundColor: '#c4252a',
                                pointBorderColor: 'white',
                                pointBorderWidth: 2,
                                pointRadius: 4,
                                pointHoverRadius: 6,
                                tension: 0.4
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: {
                                    display: false
                                }
                            },
                            scales: {
                                y: {
                                    beginAtZero: true,
                                    grid: {
                                        color: '#e9ecef'
                                    }
                                },
                                x: {
                                    grid: {
                                        display: false
                                    }
                                }
                            }
                        }
                    });
                    </text>
            }

            // Type Distribution Chart
            @if (Model.Statistics.TypeDistribution != null && Model.Statistics.TypeDistribution.Any())
            {
                    <text>
                    var typeCtx = document.getElementById('typeChart').getContext('2d');
                    new Chart(typeCtx, {
                        type: 'doughnut',
                        data: {
                            labels: @Html.Raw(Json.Serialize(Model.Statistics.TypeDistribution.Select(t => t.Label))),
                            datasets: [{
                                data: @Html.Raw(Json.Serialize(Model.Statistics.TypeDistribution.Select(t => t.Value))),
                                backgroundColor: [
                                    '#c4252a',
                                    '#28a745',
                                    '#ffc107',
                                    '#17a2b8',
                                    '#6c757d',
                                    '#dc3545',
                                    '#fd7e14'
                                ],
                                borderWidth: 0
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: {
                                    position: 'bottom',
                                    labels: {
                                        boxWidth: 12,
                                        padding: 15,
                                        font: {
                                            size: 11
                                        }
                                    }
                                }
                            },
                            cutout: '70%'
                        }
                    });
                    </text>
            }
        }

        // Refresh data
        function refreshData() {
            $('#loadingOverlay').fadeIn();
            $('#filterForm').submit();
        }

        // Handle filter form submission
        $('#filterForm').submit(function(e) {
            $('#loadingOverlay').fadeIn();
            return true;
        });

        // Keyboard shortcuts
        $(document).keydown(function(e) {
            // Ctrl + F - Focus search
            if (e.ctrlKey && e.key === 'f') {
                e.preventDefault();
                $('input[name="searchTerm"]').focus();
            }
            // Ctrl + R - Refresh
            if (e.ctrlKey && e.key === 'r') {
                e.preventDefault();
                refreshData();
            }
        });

        // Auto-submit on page size change
        $('select[name="pageSize"]').change(function() {
            $('#filterForm').submit();
        });

        // Tooltip initialization
        $('[title]').tooltip();
    </script>
}

@functions {
    public string GetPageUrl(int page, TicketListViewModel model)
    {
        var queryParams = new List<string>();
        queryParams.Add($"page={page}");
        queryParams.Add($"pageSize={model.PageSize}");

        if (!string.IsNullOrEmpty(model.SearchTerm))
            queryParams.Add($"searchTerm={Uri.EscapeDataString(model.SearchTerm)}");

        if (!string.IsNullOrEmpty(model.Status))
            queryParams.Add($"status={model.Status}");

        if (!string.IsNullOrEmpty(model.TicketType))
            queryParams.Add($"kind={model.TicketType}");

        if (model.TypeId.HasValue)
            queryParams.Add($"typeId={model.TypeId}");

        if (!string.IsNullOrEmpty(model.Priority))
            queryParams.Add($"priority={model.Priority}");

        if (!string.IsNullOrEmpty(model.AssignedTo))
            queryParams.Add($"assignedTo={Uri.EscapeDataString(model.AssignedTo)}");

        if (!string.IsNullOrEmpty(model.ReporterType))
            queryParams.Add($"reporterType={model.ReporterType}");

        if (!string.IsNullOrEmpty(model.DateFrom))
            queryParams.Add($"dateFrom={model.DateFrom}");

        if (!string.IsNullOrEmpty(model.DateTo))
            queryParams.Add($"dateTo={model.DateTo}");

        return $"?{string.Join("&", queryParams)}";
    }
}
