@model ShareIT.Models.Video

@{
    ViewData["Title"] = "Video Details";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Video Details</h1>
        <div>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back to List
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <!-- Main Content -->
        <div class="col-lg-8">
            <!-- Video Player Card -->
            <div class="card mb-4">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-play-circle"></i> Video Player
                    </h5>
                </div>
                <div class="card-body p-0">
                    @if (!string.IsNullOrEmpty(Model.VideoPath))
                    {
                        <div class="ratio ratio-16x9">
                            <video controls class="rounded-0">
                                <source src="@Model.VideoPath" type="video/@Model.FileType?.ToLower()">
                                Your browser does not support the video tag.
                            </video>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning m-3">
                            <i class="fas fa-exclamation-triangle"></i>
                            <strong>Video file not found!</strong> The video file may have been moved or deleted.
                        </div>
                    }
                </div>
            </div>

            <!-- Video Information Card -->
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-info-circle"></i> Video Information
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <dl class="row mb-0">
                                <dt class="col-sm-4">ID:</dt>
                                <dd class="col-sm-8">@Model.Id</dd>

                                <dt class="col-sm-4">Section:</dt>
                                <dd class="col-sm-8">
                                    <span class="badge bg-info">@Model.Section</span>
                                </dd>

                                <dt class="col-sm-4">File Name:</dt>
                                <dd class="col-sm-8">
                                    <i class="fas fa-file-video"></i> @Model.FileName
                                </dd>

                                <dt class="col-sm-4">File Type:</dt>
                                <dd class="col-sm-8">
                                    <span class="badge bg-secondary">@Model.FileType</span>
                                </dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <dl class="row mb-0">
                                <dt class="col-sm-4">File Size:</dt>
                                <dd class="col-sm-8">
                                    @if (Model.FileSize >= 1024 * 1024 * 1024)
                                    {
                                        @($"{Model.FileSize / (1024.0 * 1024 * 1024):F2} GB")
                                    }
                                    else if (Model.FileSize >= 1024 * 1024)
                                    {
                                        @($"{Model.FileSize / (1024.0 * 1024):F2} MB")
                                    }
                                    else if (Model.FileSize >= 1024)
                                    {
                                        @($"{Model.FileSize / 1024.0:F2} KB")
                                    }
                                    else
                                    {
                                        @($"{Model.FileSize} bytes")
                                    }
                                </dd>

                                @if (!string.IsNullOrEmpty(Model.Duration))
                                {
                                    <dt class="col-sm-4">Duration:</dt>
                                    <dd class="col-sm-8">
                                        <i class="fas fa-clock"></i> @Model.Duration
                                    </dd>
                                }

                                <dt class="col-sm-4">Upload Date:</dt>
                                <dd class="col-sm-8">
                                    <i class="fas fa-calendar-alt"></i> @Model.CreatedOn.ToString()
                                </dd>

                               
                            </dl>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.VideoPath))
                    {
                        <hr />
                        <div class="mt-3">
                            <label class="fw-bold">Video Path:</label>
                            <div class="input-group mt-1">
                                <input type="text" class="form-control form-control-sm" value="@Model.VideoPath" id="videoPath" readonly>
                                <button class="btn btn-sm btn-outline-primary" onclick="copyToClipboard()">
                                    <i class="fas fa-copy"></i> Copy
                                </button>
                                <a href="@Model.VideoPath" target="_blank" class="btn btn-sm btn-outline-info">
                                    <i class="fas fa-external-link-alt"></i> Open
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <!-- Quick Actions Card -->
            <div class="card mb-4">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-cogs"></i> Quick Actions
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                            <i class="fas fa-edit"></i> Edit Video
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                            <i class="fas fa-trash"></i> Delete Video
                        </a>
                        <a asp-action="Create" class="btn btn-primary">
                            <i class="fas fa-upload"></i> Upload New Video
                        </a>
                        <a asp-action="Index" class="btn btn-info">
                            <i class="fas fa-list"></i> View All Videos
                        </a>
                    </div>
                </div>
            </div>

            <!-- Video Statistics Card -->
            <div class="card mb-4">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-chart-bar"></i> Video Statistics
                    </h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="fw-bold">File Information:</label>
                        <ul class="list-unstyled mt-2">
                            <li class="mb-2">
                                <i class="fas fa-tag text-primary"></i>
                                <strong>Extension:</strong> .@Model.FileType?.ToLower()
                            </li>
                            <li class="mb-2">
                                <i class="fas fa-weight-hanging text-primary"></i>
                                <strong>Size in KB:</strong> @((Model.FileSize / 1024).ToString("N0")) KB
                            </li>
                            @if (Model.FileSize >= 1024 * 1024)
                            {
                                <li class="mb-2">
                                    <i class="fas fa-database text-primary"></i>
                                    <strong>Size in MB:</strong> @((Model.FileSize / (1024.0 * 1024)).ToString("N2")) MB
                                </li>
                            }
                        </ul>
                    </div>

                    <hr />

                    <div>
                        <label class="fw-bold">Usage Information:</label>
                        <ul class="list-unstyled mt-2">
                            <li class="mb-2">
                                <i class="fas fa-calendar-week text-success"></i>
                                <strong>Upload time:</strong> @Model.CreatedOn.ToString()
                            </li>
                         
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Tips Card -->
            <div class="card">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-lightbulb"></i> Tips
                    </h5>
                </div>
                <div class="card-body">
                    <ul class="mb-0">
                        <li class="mb-2">Use the <strong>Edit</strong> button to update video section or replace the file</li>
                        <li class="mb-2">Click <strong>Delete</strong> to permanently remove this video</li>
                        <li class="mb-2">Copy the video path to embed in other pages</li>
                        <li>Check video quality and playback before sharing</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Copy to clipboard function
        function copyToClipboard() {
            const pathInput = document.getElementById('videoPath');
            pathInput.select();
            pathInput.setSelectionRange(0, 99999);

            try {
                document.execCommand('copy');

                // Show temporary success message
                const copyBtn = document.querySelector('button[onclick="copyToClipboard()"]');
                const originalText = copyBtn.innerHTML;
                copyBtn.innerHTML = '<i class="fas fa-check"></i> Copied!';
                copyBtn.classList.add('btn-success');
                copyBtn.classList.remove('btn-outline-primary');

                setTimeout(() => {
                    copyBtn.innerHTML = originalText;
                    copyBtn.classList.remove('btn-success');
                    copyBtn.classList.add('btn-outline-primary');
                }, 2000);
            } catch (err) {
                console.error('Failed to copy: ', err);
                alert('Failed to copy to clipboard');
            }
        }

        // Auto-dismiss alerts after 5 seconds
        setTimeout(function() {
            const alerts = document.querySelectorAll('.alert');
            alerts.forEach(alert => {
                alert.classList.add('fade');
                setTimeout(() => alert.remove(), 500);
            });
        }, 5000);

        // Add keyboard shortcut (Ctrl+C) for video path
        document.addEventListener('keydown', function(e) {
            if (e.ctrlKey && e.key === 'c') {
                const pathInput = document.getElementById('videoPath');
                if (document.activeElement === pathInput) {
                    copyToClipboard();
                }
            }
        });
    </script>
}