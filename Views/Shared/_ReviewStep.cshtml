@using ShareIT.Models.ViewModel
@model NewTicketViewModel

<div class="step-content">
    <div class="alert alert-dark border-danger mb-4">
        <div class="d-flex align-items-center">
            <i class="fas fa-clipboard-check fa-2x text-danger me-3"></i>
            <div>
                <h6 class="mb-1">Final Review Before Submission</h6>
                <p class="mb-0 text-muted">Please review all information carefully. Once submitted, changes cannot be made.</p>
            </div>
        </div>
    </div>


    <!-- Summary Sections -->
    <div class="row">
        <!-- Left Column -->
        <div class="col-lg-6 mb-4">
            <!-- Reporter Summary -->
            <div class="card border-danger mb-4">
                <div class="card-header bg-danger text-white">
                    <h6 class="mb-0"><i class="fas fa-user me-2"></i> Reporter Information</h6>
                </div>
                <div class="card-body">
                    <div class="summary-item mb-3">
                        <div class="summary-label text-muted">Reporter Type</div>
                        <div class="summary-value">
                            @if (Model.ReporterType == "Disclose")
                            {
                                <span class="badge bg-danger">
                                    <i class="fas fa-user-check me-1"></i> Disclosed Identity
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-dark">
                                    <i class="fas fa-user-secret me-1"></i> Anonymous
                                </span>
                            }
                        </div>
                    </div>

                    @if (Model.ReporterType == "Disclose")
                    {
                        if (Model.IsEmployee == "Yes")
                        {
                            <div class="summary-item mb-3">
                                <div class="summary-label text-muted">Employee Details</div>
                                <div class="summary-content">
                                    <div class="d-flex align-items-center mb-2">
                                        <i class="fas fa-id-card text-danger me-2"></i>
                                        <span class="fw-bold">@Model.EmpName</span>
                                    </div>
                                    <div class="row small">
                                        <div class="col-6">
                                            <i class="fas fa-hashtag text-muted me-1"></i>
                                            @Model.EmpNum
                                        </div>
                                        <div class="col-6">
                                            <i class="fas fa-phone text-muted me-1"></i>
                                            @Model.EmpMobile
                                        </div>
                                        <div class="col-12 mt-1">
                                            <i class="fas fa-envelope text-muted me-1"></i>
                                            @Model.EmpEmail1
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="summary-item mb-3">
                                <div class="summary-label text-muted">External Party Details</div>
                                <div class="summary-content">
                                    <div class="d-flex align-items-center mb-2">
                                        <i class="fas fa-user text-danger me-2"></i>
                                        <span class="fw-bold">@Model.NonEmpName</span>
                                    </div>
                                    <div class="row small">
                                        <div class="col-6">
                                            <i class="fas fa-building text-muted me-1"></i>
                                            @Model.Organization
                                        </div>
                                        <div class="col-6">
                                            <i class="fas fa-phone text-muted me-1"></i>
                                            @Model.NonEmpMobile
                                        </div>
                                        <div class="col-12 mt-1">
                                            <i class="fas fa-envelope text-muted me-1"></i>
                                            @Model.NonEmpEmail1
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-3">
                            <i class="fas fa-user-secret fa-3x text-dark mb-2"></i>
                            <p class="text-muted mb-0">Anonymous Reporter</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Case Tracking Password — inputs submit via the OUTER form in New.cshtml -->
            <div class="card border-dark">
                <div class="card-header bg-dark text-white">
                    <h6 class="mb-0"><i class="fas fa-lock me-2"></i> Case Tracking Password</h6>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning border-danger mb-3">
                        <i class="fas fa-key me-2"></i>
                        <strong>Important:</strong> This password is required to track your case status.
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Password" class="form-label">
                                <i class="fas fa-key me-2 text-danger"></i>Password
                            </label>
                            <span class="text-danger">*</span>
                            <input asp-for="Password" type="password" class="form-control" id="passwordInput" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ConfirmPassword" class="form-label">
                                <i class="fas fa-key me-2 text-danger"></i>Confirm Password
                            </label>
                            <span class="text-danger">*</span>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="password-requirements mt-3">
                        <small class="text-muted d-block mb-2">Password must contain:</small>
                        <ul class="list-unstyled mb-0 small">
                            <li class="mb-1"><i class="fas fa-check-circle text-success me-2"></i>At least 8 characters</li>
                            <li class="mb-1"><i class="fas fa-check-circle text-success me-2"></i>One uppercase letter</li>
                            <li class="mb-1"><i class="fas fa-check-circle text-success me-2"></i>One number</li>
                            <li><i class="fas fa-check-circle text-success me-2"></i>One special character</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column -->
        <div class="col-lg-6 mb-4">
            <!-- Ticket Summary -->
            <div class="card border-danger mb-4">
                <div class="card-header bg-danger text-white">
                    <h6 class="mb-0"><i class="fas fa-exclamation-circle me-2"></i> Ticket Details</h6>
                </div>
                <div class="card-body">
                    <div class="summary-item mb-3">
                        <div class="summary-label text-muted">Ticket Concerning</div>
                        <div class="summary-content">
                            <div class="d-flex align-items-center mb-2">
                                <i class="fas fa-building text-danger me-2"></i>
                                @{
                                    var concerningCompany = Model.Companies?.FirstOrDefault(c => c.Id == Model.ConcerningCompanyId);
                                    <span class="fw-bold">@(concerningCompany?.Name ?? "N/A")</span>
                                }
                            </div>
                            <div class="d-flex align-items-center">
                                <i class="fas fa-sitemap text-danger me-2"></i>
                                @{
                                    var concerningDepartment = Model.Departments?.FirstOrDefault(d => d.Id == Model.ConcerningDepartmentId);
                                    <span>@(concerningDepartment?.Name ?? "N/A")</span>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(Model.ConcerningPerson))
                            {
                                <div class="d-flex align-items-center mt-2">
                                    <i class="fas fa-user text-danger me-2"></i>
                                    <span>@Model.ConcerningPerson</span>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="summary-item">
                        <div class="summary-label text-muted">Description</div>
                        <div class="summary-content">
                            <div class="description-review p-3 bg-light rounded">
                                @if (!string.IsNullOrEmpty(Model.Description))
                                {
                                    @Html.Raw(Model.Description.Replace("\n", "<br />"))
                                }
                                else
                                {
                                    <span class="text-muted">No description provided</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Attachments Summary -->
            @if (Model.UploadedFiles?.Count > 0)
            {
                <div class="card border-dark">
                    <div class="card-header bg-dark text-white">
                        <h6 class="mb-0"><i class="fas fa-paperclip me-2"></i> Supporting Documents</h6>
                    </div>
                    <div class="card-body">
                        <div class="attachments-list">
                            @foreach (var file in Model.UploadedFiles)
                            {
                                var fileName = System.IO.Path.GetFileName(file);
                                var extension = System.IO.Path.GetExtension(file).ToLower();
                                <div class="attachment-item d-flex align-items-center mb-2 p-2 border rounded">
                                    <div class="file-icon me-3">
                                        <i class="@GetFileIconClass(extension)"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="fw-bold text-dark">@fileName</div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Reference Number -->
    <div class="card border-danger">
        <div class="card-header bg-danger text-white">
            <h6 class="mb-0"><i class="fas fa-hashtag me-2"></i> Your Case Reference</h6>
        </div>
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <div class="ref-number-display">
                        <h2 class="display-4 fw-bold text-danger mb-2">@Model.RefNo</h2>
                        <p class="text-muted mb-0">
                            <i class="fas fa-info-circle me-1"></i>
                            Save this number along with your password to track your case status.
                        </p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="d-grid gap-2">
                        <button type="button" class="btn btn-dark"
                                onclick="copyToClipboard('@Model.RefNo')">
                            <i class="fas fa-copy me-2"></i> Copy Reference
                        </button>
                        <button type="button" class="btn btn-outline-danger" onclick="printPage()">
                            <i class="fas fa-print me-2"></i> Print Summary
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Submit Warning -->
    <div class="alert alert-warning border-danger mt-4">
        <div class="d-flex">
            <div class="flex-shrink-0">
                <i class="fas fa-exclamation-triangle fa-2x text-danger"></i>
            </div>
            <div class="flex-grow-1 ms-3">
                <h5 class="alert-heading">Before You Submit</h5>
                <ul class="mb-0">
                    <li>All information provided is accurate to the best of your knowledge</li>
                    <li>You understand that false reporting may have consequences</li>
                    <li>You have saved your reference number and password</li>
                    <li>You will receive confirmation once the ticket is processed</li>
                </ul>
            </div>
        </div>
    </div>
</div>


@functions {
    public string GetFileIconClass(string extension)
    {
        return extension switch
        {
            ".docx" or ".doc" => "fas fa-file-word text-primary",
            ".pdf" => "fas fa-file-pdf text-danger",
            ".wav" or ".mp3" => "fas fa-file-audio text-info",
            ".jpg" or ".png" => "fas fa-file-image text-success",
            ".msg" => "fas fa-envelope text-warning",
            _ => "fas fa-file text-secondary"
        };
    }
}

<style>
    .summary-item {
        padding: 10px 0;
        border-bottom: 1px solid #e9ecef;
    }
    
    .summary-item:last-child {
        border-bottom: none;
    }
    
    .summary-label {
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 5px;
    }
    
    .summary-value {
        font-weight: 600;
        color: #000;
    }
    
    .summary-content {
        color: #495057;
    }
    
    .description-review {
        max-height: 200px;
        overflow-y: auto;
        font-size: 14px;
        line-height: 1.6;
        background: white !important;
        border: 1px solid #dee2e6;
    }
    
    .file-icon {
        width: 40px;
        height: 40px;
        background: linear-gradient(135deg, #f8f9fa, #e9ecef);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    
    .attachment-item {
        background: white;
        transition: all 0.3s;
    }
    
    .attachment-item:hover {
        border-color: #c4252a;
        transform: translateX(5px);
    }
    
    .ref-number-display {
        text-align: center;
    }
    
    @@media (min-width: 768px) {
        .ref-number-display {
            text-align: left;
        }
    }
    
    .password-requirements li i {
        font-size: 12px;
    }
</style>

<!-- In your HTML -->
<script src="~/js/ticket.js"></script>
<script>
    // Use the functions from the external file
    function copyRefNumber() {
        copyToClipboard('@Model.RefNo');
    }

    function printSummary() {
        printPage('@Model.RefNo');
    }
</script>

<!-- Update buttons to call correct functions -->
<button type="button" class="btn btn-dark" onclick="copyRefNumber()">
    <i class="fas fa-copy me-2"></i> Copy Reference
</button>
<button type="button" class="btn btn-outline-danger" onclick="printSummary()">
    <i class="fas fa-print me-2"></i> Print Summary
</button>
