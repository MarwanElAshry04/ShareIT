@using ShareIT.Models
@using ShareIT.Models.ViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@model NewTicketViewModel

<div class="step-content">
    <!-- Shared: Title + Description (every type) -->
    <div class="card mb-4 border-danger">
        <div class="card-header bg-danger text-white">
            <h6 class="mb-0"><i class="fas fa-heading me-2"></i> @Model.TicketType Details</h6>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <label asp-for="Title" class="form-label">@L["Title"] <span class="text-danger">*</span></label>
                <input asp-for="Title" class="form-control" placeholder="@L["A short, clear title"]" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>
            <div class="mb-0">
                <label asp-for="Description" class="form-label">@L["Description"] <span class="text-danger">*</span></label>
                <textarea asp-for="Description" class="form-control" rows="5" placeholder="@L["Describe it in detail"]"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>
        </div>
    </div>

    @* Type-specific fields *@
    @if (Model.TicketType == TicketType.Issue)
    {
        <div class="card mb-4 border-dark">
            <div class="card-header bg-dark text-white"><h6 class="mb-0">@L["Issue"]</h6></div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Issue.IssueType" class="form-label">@L["Issue Type"]</label>
                        <input asp-for="Issue.IssueType" class="form-control" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Issue.ImpactArea" class="form-label">@L["Impact Area"]</label>
                        <select asp-for="Issue.ImpactArea" class="form-select" asp-items="Html.GetEnumSelectList<IssueImpactArea>()"></select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Issue.ResponsibleDepartmentId" class="form-label">@L["Responsible Department"]</label>
                        <select asp-for="Issue.ResponsibleDepartmentId" class="form-select" asp-items="@(new SelectList(Model.Departments, "Id", "Name"))"><option value="">@L["-- Select --"]</option></select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Issue.SolutionCategory" class="form-label">@L["Proposed Solution Type"]</label>
                        <select asp-for="Issue.SolutionCategory" class="form-select" asp-items="Html.GetEnumSelectList<SolutionCategory>()"><option value="">@L["-- Select --"]</option></select>
                    </div>
                    <div class="col-12 mb-3">
                        <label asp-for="Issue.RootCause" class="form-label">@L["Root Cause (if known)"]</label>
                        <textarea asp-for="Issue.RootCause" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="col-12 mb-0">
                        <label asp-for="Issue.ProposedSolution" class="form-label">@L["Proposed Solution"]</label>
                        <textarea asp-for="Issue.ProposedSolution" class="form-control" rows="2"></textarea>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (Model.TicketType == TicketType.Idea)
    {
        <div class="card mb-4 border-dark">
            <div class="card-header bg-dark text-white"><h6 class="mb-0">@L["Idea"]</h6></div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Idea.Scope" class="form-label">@L["Scope"]</label>
                        <select asp-for="Idea.Scope" class="form-select" asp-items="Html.GetEnumSelectList<IdeaScope>()"></select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Idea.ImpactType" class="form-label">@L["Impact"]</label>
                        <select asp-for="Idea.ImpactType" class="form-select" asp-items="Html.GetEnumSelectList<ImpactType>()"></select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Idea.ResponsibleDepartmentId" class="form-label">@L["Responsible Department"]</label>
                        <select asp-for="Idea.ResponsibleDepartmentId" class="form-select" asp-items="@(new SelectList(Model.Departments, "Id", "Name"))"><option value="">@L["-- Select --"]</option></select>
                    </div>
                    <div class="col-12 mb-3">
                        <label asp-for="Idea.ImpactDescription" class="form-label">@L["Describe The Impact"]</label>
                        <textarea asp-for="Idea.ImpactDescription" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="col-12 mb-0">
                        <label asp-for="Idea.Sustainability" class="form-label">@L["Sustainability"]</label>
                        <textarea asp-for="Idea.Sustainability" class="form-control" rows="2"></textarea>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (Model.TicketType == TicketType.ProjectProposal)
    {
        <div class="card mb-4 border-dark">
            <div class="card-header bg-dark text-white"><h6 class="mb-0">@L["Project Proposal"]</h6></div>
            <div class="card-body">
                <div class="row">
                    <div class="col-12 mb-3">
                        <label asp-for="ProjectProposal.BusinessNeed" class="form-label">@L["Business Need"]</label>
                        <textarea asp-for="ProjectProposal.BusinessNeed" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="ProjectProposal.EstimatedCost" class="form-label">@L["Estimated Cost"]</label>
                        <input asp-for="ProjectProposal.EstimatedCost" class="form-control" type="number" step="0.01" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="ProjectProposal.RoiReach" class="form-label">@L["Expected ROI"]</label>
                        <select asp-for="ProjectProposal.RoiReach" class="form-select" asp-items="Html.GetEnumSelectList<RoiReach>()"></select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="ProjectProposal.TimelineStart" class="form-label">@L["Timeline Start"]</label>
                        <input asp-for="ProjectProposal.TimelineStart" class="form-control" type="date" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="ProjectProposal.TimelineEnd" class="form-label">@L["Timeline End"]</label>
                        <input asp-for="ProjectProposal.TimelineEnd" class="form-control" type="date" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="ProjectProposal.Scope" class="form-label">@L["Scope"]</label>
                        <input asp-for="ProjectProposal.Scope" class="form-control" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="ProjectProposal.KeyStakeholders" class="form-label">@L["Key Stakeholders"]</label>
                        <input asp-for="ProjectProposal.KeyStakeholders" class="form-control" placeholder="e.g. Financial, Safety" />
                    </div>
                    <div class="col-12 mb-0">
                        <label asp-for="ProjectProposal.ExpectedBenefits" class="form-label">@L["Expected Benefits"]</label>
                        <textarea asp-for="ProjectProposal.ExpectedBenefits" class="form-control" rows="2"></textarea>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (Model.TicketType == TicketType.SafetyConcern)
    {
        <div class="card mb-4 border-dark">
            <div class="card-header bg-dark text-white"><h6 class="mb-0">@L["Safety Concern"]</h6></div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Safety.RiskLevel" class="form-label">@L["Risk Level"]</label>
                        <select asp-for="Safety.RiskLevel" class="form-select" asp-items="Html.GetEnumSelectList<RiskLevel>()"></select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Safety.HazardCategory" class="form-label">@L["Category"]</label>
                        <select asp-for="Safety.HazardCategory" class="form-select" asp-items="Html.GetEnumSelectList<SafetyHazard>()"></select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Safety.ResponsibleDepartmentId" class="form-label">@L["Responsible Department"]</label>
                        <select asp-for="Safety.ResponsibleDepartmentId" class="form-select" asp-items="@(new SelectList(Model.Departments, "Id", "Name"))"><option value="">@L["-- Select --"]</option></select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Safety.PotentialImpact" class="form-label">@L["Potential Impact"]</label>
                        <input asp-for="Safety.PotentialImpact" class="form-control" placeholder="e.g. Injury, Downtime" />
                    </div>
                    <div class="col-12 mb-0">
                        <label asp-for="Safety.SuggestedAction" class="form-label">@L["Suggested Preventive / Corrective Action"]</label>
                        <textarea asp-for="Safety.SuggestedAction" class="form-control" rows="2"></textarea>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (Model.TicketType == TicketType.Feedback)
    {
        <div class="card mb-4 border-dark">
            <div class="card-header bg-dark text-white"><h6 class="mb-0">@L["Feedback"]</h6></div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Feedback.Category" class="form-label">@L["Category"]</label>
                        <select asp-for="Feedback.Category" class="form-select" asp-items="Html.GetEnumSelectList<FeedbackCategory>()"></select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Feedback.ResponsibleDepartmentId" class="form-label">@L["Responsible Department"]</label>
                        <select asp-for="Feedback.ResponsibleDepartmentId" class="form-select" asp-items="@(new SelectList(Model.Departments, "Id", "Name"))"><option value="">@L["-- Select --"]</option></select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Feedback.PreferredResolution" class="form-label">@L["Preferred Resolution"]</label>
                        <select asp-for="Feedback.PreferredResolution" class="form-select" asp-items="Html.GetEnumSelectList<PreferredResolution>()"></select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Feedback.Confidentiality" class="form-label">@L["Confidentiality"]</label>
                        <select asp-for="Feedback.Confidentiality" class="form-select" asp-items="Html.GetEnumSelectList<Confidentiality>()"></select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Feedback.ActionType" class="form-label">@L["Action Type"]</label>
                        <select asp-for="Feedback.ActionType" class="form-select" asp-items="Html.GetEnumSelectList<FeedbackActionType>()"></select>
                    </div>
                    <div class="col-md-6 mb-0">
                        <label asp-for="Feedback.ImpactArea" class="form-label">@L["Impact Area"]</label>
                        <input asp-for="Feedback.ImpactArea" class="form-control" />
                    </div>
                </div>
            </div>
        </div>
    }
    else if (Model.TicketType == TicketType.SystemRequest)
    {
        <div class="alert alert-light border">
            <i class="fas fa-info-circle text-danger me-2"></i>
            @L["A System Request only needs the title and description above."]
        </div>
    }
</div>