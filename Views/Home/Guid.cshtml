</div>

<!-- Video Modal -->
<div class="modal fade" id="videoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="videoModalTitle">Tutorial Video</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="ratio ratio-16x9">
                    <video id="tutorialVideo" controls>
                        <source src="" type="video/mp4">
                        Your browser does not support the video tag.
                    </video>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Font Awesome Icons -->
@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
}

@section Scripts {
    <script>
        $(document).ready(function () {
            // Video Modal Handling
            const videoModal = new bootstrap.Modal(document.getElementById('videoModal'));
            const tutorialVideo = document.getElementById('tutorialVideo');
            
            // Map video names to actual video files
            const videoFiles = {
                'file-new-case': '/videos/file-new-case.mp4',
                'document-upload': '/videos/document-upload.mp4',
                'confidential-reporting': '/videos/confidential.mp4',
                'track-case': '/videos/track-case.mp4',
                'chat-system': '/videos/chat-system.mp4',
                'case-updates': '/videos/case-updates.mp4',
                'shareit-1': '/videos/shareit-1.mp4',
                'shareit-2': '/videos/shareit-2.mp4',
                'shareit-3': '/videos/shareit-3.mp4',
                'shareit-4': '/videos/shareit-4.mp4'
            };
            
            // Handle tutorial button clicks
            $('.btn-tutorial').click(function (e) {
                e.preventDefault();
                const videoName = $(this).data('video');
                const videoPath = videoFiles[videoName] || '/videos/default.mp4';
                
                // Update video source
                tutorialVideo.src = videoPath;
                tutorialVideo.load();
                
                // Update modal title
                $('#videoModalTitle').text($(this).closest('.tutorial-card').find('.card-header h3').text());
                
                // Show modal
                videoModal.show();
            });
            
            // Reset video when modal is closed
            $('#videoModal').on('hidden.bs.modal', function () {
                tutorialVideo.pause();
                tutorialVideo.currentTime = 0;
            });
            
            // Card hover animations
            $('.tutorial-card').each(function (index) {
                $(this).css('opacity', '0');
                $(this).css('transform', 'translateY(20px)');
                
                setTimeout(() => {
                    $(this).animate({
                        opacity: 1,
                        transform: 'translateY(0)'
                    }, 500);
                }, index * 100);
            });
            
            // FAQ accordion animations
            $('.accordion-button').click(function () {
                $(this).find('i').toggleClass('fa-plus fa-minus');
            });
            
            // Add tooltips for video buttons
            $('.btn-tutorial').tooltip({
                title: 'Click to watch tutorial video',
                placement: 'top'
            });
        });
    </script>
}