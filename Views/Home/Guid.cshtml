@model ShareIT.Models.ViewModel.UserGuideViewModel

@{
    ViewData["Title"] = "User Guide - ELSEWEDY ELECTRIC";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .user-guide-container {
        padding: 40px 0;
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        min-height: 100vh;
    }

    .page-header {
        text-align: center;
        margin-bottom: 50px;
        padding: 40px 20px;
        background: white;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        margin-top: 20px;
    }

        .page-header h1 {
            color: #c4252a;
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 15px;
            background: linear-gradient(135deg, #c4252a, #e02020);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .page-header p {
            color: #6c757d;
            font-size: 1.1rem;
            max-width: 700px;
            margin: 0 auto 30px;
            line-height: 1.8;
        }

    .guide-section {
        margin-bottom: 60px;
    }

    .section-header {
        display: flex;
        align-items: center;
        margin-bottom: 30px;
        padding-bottom: 15px;
        border-bottom: 3px solid #c4252a;
    }

        .section-header i {
            font-size: 28px;
            color: #c4252a;
            margin-inline-end: 15px;
            background: rgba(196, 37, 42, 0.1);
            width: 50px;
            height: 50px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .section-header h2 {
            color: #343a40;
            font-size: 1.8rem;
            font-weight: 600;
            margin: 0;
        }

    .tutorial-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 30px;
        margin-bottom: 40px;
    }

    .tutorial-card {
        background: white;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        transition: all 0.3s ease;
        position: relative;
    }

        .tutorial-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.15);
        }

    .card-header {
        background: linear-gradient(135deg, #c4252a, #e02020);
        color: white;
        padding: 20px;
        text-align: center;
    }

        .card-header h3 {
            font-size: 1.3rem;
            font-weight: 600;
            margin: 0;
        }

    .card-body {
        padding: 25px;
    }

    .tutorial-image {
        width: 100%;
        height: 180px;
        object-fit: cover;
        border-radius: 10px;
        margin-bottom: 20px;
        border: 3px solid #f8f9fa;
        transition: all 0.3s;
    }

        .tutorial-image:hover {
            transform: scale(1.05);
        }

    .tutorial-description {
        color: #6c757d;
        font-size: 0.95rem;
        line-height: 1.6;
        margin-bottom: 20px;
        text-align: center;
    }

    .tutorial-action {
        display: flex;
        justify-content: center;
    }

    .btn-tutorial {
        background: #c4252a;
        color: white;
        border: none;
        padding: 12px 30px;
        border-radius: 25px;
        font-weight: 500;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        transition: all 0.3s;
        font-size: 0.95rem;
    }

        .btn-tutorial:hover {
            background: #a61d22;
            color: white;
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(196, 37, 42, 0.3);
            text-decoration: none;
        }

        .btn-tutorial i {
            font-size: 1.1rem;
        }

    .video-play-overlay {
        position: relative;
        overflow: hidden;
        border-radius: 10px;
    }

        .video-play-overlay::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0,0,0,0.3);
            opacity: 0;
            transition: opacity 0.3s;
            z-index: 1;
            border-radius: 10px;
        }

        .video-play-overlay:hover::before {
            opacity: 1;
        }

        .video-play-overlay::after {
            content: '\f144';
            font-family: 'Font Awesome 5 Free';
            font-weight: 900;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            color: white;
            font-size: 48px;
            opacity: 0;
            transition: opacity 0.3s;
            z-index: 2;
            text-shadow: 0 2px 10px rgba(0,0,0,0.5);
        }

        .video-play-overlay:hover::after {
            opacity: 0.8;
        }

    .badge-new {
        position: absolute;
        top: 15px;
        right: 15px;
        background: #28a745;
        color: white;
        padding: 5px 12px;
        border-radius: 15px;
        font-size: 0.8rem;
        font-weight: 600;
        z-index: 3;
        box-shadow: 0 3px 10px rgba(40, 167, 69, 0.3);
    }

    .quick-guide {
        background: white;
        border-radius: 15px;
        padding: 30px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        margin-top: 40px;
    }

        .quick-guide h3 {
            color: #c4252a;
            font-size: 1.5rem;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 2px solid #f0f0f0;
        }

    .guide-steps {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
    }

    .step-item {
        text-align: center;
        padding: 20px;
        background: #f8f9fa;
        border-radius: 10px;
        transition: all 0.3s;
    }

        .step-item:hover {
            background: rgba(196, 37, 42, 0.05);
            transform: translateY(-5px);
        }

        .step-item i {
            font-size: 32px;
            color: #c4252a;
            margin-bottom: 15px;
        }

        .step-item h4 {
            font-size: 1rem;
            color: #343a40;
            margin-bottom: 10px;
        }

        .step-item p {
            font-size: 0.85rem;
            color: #6c757d;
            margin: 0;
        }

    .hr-divider {
        border: none;
        height: 1px;
        background: linear-gradient(to right, transparent, #dee2e6, transparent);
        margin: 50px 0;
    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .page-header {
            padding: 30px 15px;
        }

            .page-header h1 {
                font-size: 2rem;
            }

        .tutorial-grid {
            grid-template-columns: 1fr;
            gap: 20px;
        }

        .section-header {
            flex-direction: column;
            text-align: center;
            gap: 15px;
        }

            .section-header i {
                margin-inline-end: 0;
            }

        .guide-steps {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 576px) {
        .user-guide-container {
            padding: 20px 0;
        }

        .page-header h1 {
            font-size: 1.7rem;
        }

        .section-header h2 {
            font-size: 1.5rem;
        }

        .card-body {
            padding: 20px;
        }

        .btn-tutorial {
            padding: 10px 20px;
            font-size: 0.9rem;
        }
    }
</style>

<div class="user-guide-container">
    <div class="container">
        <!-- Page Header -->
        <div class="page-header">
            <h1>
                <i class="fas fa-graduation-cap me-2"></i>
                @L["User Guide"]
            </h1>
            <p>
                Welcome to the ELSEWEDY ELECTRIC Reporting Portal User Guide. 
                Here you'll find tutorials and resources to help you navigate our reporting system effectively.
            </p>
            <div class="quick-guide">
                <h3>@L["Quick Start Guide"]</h3>
                <div class="guide-steps">
                  
                    <div class="step-item">
                        <i class="fas fa-file-upload"></i>
                        <h4>@L["Step 1: Report"]</h4>
                        <p>@L["Submit your compliance concern"]</p>
                    </div>
                    <div class="step-item">
                        <i class="fas fa-search"></i>
                        <h4>@L["Step 2: Track"]</h4>
                        <p>@L["Monitor your case status"]</p>
                    </div>
                    <div class="step-item">
                        <i class="fas fa-comments"></i>
                        <h4>@L["Step 3: Communicate"]</h4>
                        <p>@L["Chat with compliance team"]</p>
                    </div>
                </div>
            </div>
        </div>

        @foreach (var guideSection in Model.Sections)
        {
            <div class="guide-section">
                <div class="section-header">
                    <i class="@guideSection.IconClass"></i>
                    <h2>@guideSection.Heading</h2>
                </div>

                @if (!guideSection.Videos.Any())
                {
                    <p class="tutorial-description">@L["No tutorials in this section yet."]</p>
                }
                else
                {
                    <div class="tutorial-grid">
                        @foreach (var video in guideSection.Videos)
                        {
                            <div class="tutorial-card">
                                <div class="card-header">
                                    <h3>@video.Title</h3>
                                </div>
                                <div class="card-body">
                                    <div class="video-play-overlay">
                                        <img src="@(string.IsNullOrEmpty(video.ThumbnailPath) ? "/images/tutorials/placeholder.svg" : video.ThumbnailPath)"
                                             alt="@video.Title" class="tutorial-image" />
                                    </div>
                                    <p class="tutorial-description">@video.Description</p>
                                    <div class="tutorial-action">
                                        <a href="#" class="btn-tutorial" data-video-path="@video.VideoPath">
                                            <i class="fas fa-play-circle"></i> @L["Watch Tutorial"]
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <hr class="hr-divider" />
        }

        <!-- FAQ Section -->
        <div class="guide-section">
            <div class="quick-guide">
                <h3>
                    <i class="fas fa-question-circle me-2"></i>
                    @L["Frequently Asked Questions"]
                </h3>
                <div class="accordion" id="faqAccordion">
                    <!-- FAQ 1 -->
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="faq1">
                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne">
                                @L["How long does it take to process a ticket?"]
                            </button>
                        </h2>
                        <div id="collapseOne" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">@L["Most tickets are acknowledged within 24 hours and undergo initial review within 3-5 business days. Complex cases may take longer."]</div>
                        </div>
                    </div>
                    
                    <!-- FAQ 2 -->
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="faq2">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo">
                                @L["Is my report confidential?"]
                            </button>
                        </h2>
                        <div id="collapseTwo" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">@L["Yes, all reports are handled with strict confidentiality. Your identity is protected according to our privacy policy."]</div>
                        </div>
                    </div>
                    
                    <!-- FAQ 3 -->
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="faq3">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree">
                                @L["Can I submit a report anonymously?"]
                            </button>
                        </h2>
                        <div id="collapseThree" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">@L["Yes, you can choose to submit an anonymous report. However, providing contact information helps us follow up for additional details if needed."]</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Video Modal -->
<div class="modal fade" id="videoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="videoModalTitle">@L["Tutorial Video"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="ratio ratio-16x9">
                    <video id="tutorialVideo" controls>
                        <source src="" type="video/mp4">
                        @L["Your browser does not support the video tag."]
                    </video>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Font Awesome Icons -->
@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
}

@section Scripts {
    <script>
        $(document).ready(function () {
            // Video Modal Handling
            const videoModal = new bootstrap.Modal(document.getElementById('videoModal'));
            const tutorialVideo = document.getElementById('tutorialVideo');
            
            // Handle tutorial button clicks — each card carries its own video path
            $('.btn-tutorial').click(function (e) {
                e.preventDefault();

                const videoPath = $(this).data('video-path');
                if (!videoPath) {
                    return;
                }

                // Update video source
                tutorialVideo.src = videoPath;
                tutorialVideo.load();

                // Update modal title
                $('#videoModalTitle').text($(this).closest('.tutorial-card').find('.card-header h3').text());

                // Show modal
                videoModal.show();
            });
            
            // Reset video when modal is closed
            $('#videoModal').on('hidden.bs.modal', function () {
                tutorialVideo.pause();
                tutorialVideo.currentTime = 0;
            });
            
            // Card hover animations
            $('.tutorial-card').each(function (index) {
                $(this).css('opacity', '0');
                $(this).css('transform', 'translateY(20px)');
                
                setTimeout(() => {
                    $(this).animate({
                        opacity: 1,
                        transform: 'translateY(0)'
                    }, 500);
                }, index * 100);
            });
            
            // FAQ accordion animations
            $('.accordion-button').click(function () {
                $(this).find('i').toggleClass('fa-plus fa-minus');
            });
            
            // Add tooltips for video buttons
            $('.btn-tutorial').tooltip({
                title: 'Click to watch tutorial video',
                placement: 'top'
            });
        });
    </script>
}