@{
    ViewData["Title"] = "User Guide - ELSEWEDY ELECTRIC";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .user-guide-container {
        padding: 40px 0;
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        min-height: 100vh;
    }

    .page-header {
        text-align: center;
        margin-bottom: 50px;
        padding: 40px 20px;
        background: white;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        margin-top: 20px;
    }

        .page-header h1 {
            color: #c4252a;
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 15px;
            background: linear-gradient(135deg, #c4252a, #e02020);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .page-header p {
            color: #6c757d;
            font-size: 1.1rem;
            max-width: 700px;
            margin: 0 auto 30px;
            line-height: 1.8;
        }

    .guide-section {
        margin-bottom: 60px;
    }

    .section-header {
        display: flex;
        align-items: center;
        margin-bottom: 30px;
        padding-bottom: 15px;
        border-bottom: 3px solid #c4252a;
    }

        .section-header i {
            font-size: 28px;
            color: #c4252a;
            margin-right: 15px;
            background: rgba(196, 37, 42, 0.1);
            width: 50px;
            height: 50px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .section-header h2 {
            color: #343a40;
            font-size: 1.8rem;
            font-weight: 600;
            margin: 0;
        }

    .tutorial-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 30px;
        margin-bottom: 40px;
    }

    .tutorial-card {
        background: white;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        transition: all 0.3s ease;
        position: relative;
    }

        .tutorial-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.15);
        }

    .card-header {
        background: linear-gradient(135deg, #c4252a, #e02020);
        color: white;
        padding: 20px;
        text-align: center;
    }

        .card-header h3 {
            font-size: 1.3rem;
            font-weight: 600;
            margin: 0;
        }

    .card-body {
        padding: 25px;
    }

    .tutorial-image {
        width: 100%;
        height: 180px;
        object-fit: cover;
        border-radius: 10px;
        margin-bottom: 20px;
        border: 3px solid #f8f9fa;
        transition: all 0.3s;
    }

        .tutorial-image:hover {
            transform: scale(1.05);
        }

    .tutorial-description {
        color: #6c757d;
        font-size: 0.95rem;
        line-height: 1.6;
        margin-bottom: 20px;
        text-align: center;
    }

    .tutorial-action {
        display: flex;
        justify-content: center;
    }

    .btn-tutorial {
        background: #c4252a;
        color: white;
        border: none;
        padding: 12px 30px;
        border-radius: 25px;
        font-weight: 500;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        transition: all 0.3s;
        font-size: 0.95rem;
    }

        .btn-tutorial:hover {
            background: #a61d22;
            color: white;
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(196, 37, 42, 0.3);
            text-decoration: none;
        }

        .btn-tutorial i {
            font-size: 1.1rem;
        }

    .video-play-overlay {
        position: relative;
        overflow: hidden;
        border-radius: 10px;
    }

        .video-play-overlay::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0,0,0,0.3);
            opacity: 0;
            transition: opacity 0.3s;
            z-index: 1;
            border-radius: 10px;
        }

        .video-play-overlay:hover::before {
            opacity: 1;
        }

        .video-play-overlay::after {
            content: '\f144';
            font-family: 'Font Awesome 5 Free';
            font-weight: 900;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            color: white;
            font-size: 48px;
            opacity: 0;
            transition: opacity 0.3s;
            z-index: 2;
            text-shadow: 0 2px 10px rgba(0,0,0,0.5);
        }

        .video-play-overlay:hover::after {
            opacity: 0.8;
        }

    .badge-new {
        position: absolute;
        top: 15px;
        right: 15px;
        background: #28a745;
        color: white;
        padding: 5px 12px;
        border-radius: 15px;
        font-size: 0.8rem;
        font-weight: 600;
        z-index: 3;
        box-shadow: 0 3px 10px rgba(40, 167, 69, 0.3);
    }

    .quick-guide {
        background: white;
        border-radius: 15px;
        padding: 30px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        margin-top: 40px;
    }

        .quick-guide h3 {
            color: #c4252a;
            font-size: 1.5rem;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 2px solid #f0f0f0;
        }

    .guide-steps {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
    }

    .step-item {
        text-align: center;
        padding: 20px;
        background: #f8f9fa;
        border-radius: 10px;
        transition: all 0.3s;
    }

        .step-item:hover {
            background: rgba(196, 37, 42, 0.05);
            transform: translateY(-5px);
        }

        .step-item i {
            font-size: 32px;
            color: #c4252a;
            margin-bottom: 15px;
        }

        .step-item h4 {
            font-size: 1rem;
            color: #343a40;
            margin-bottom: 10px;
        }

        .step-item p {
            font-size: 0.85rem;
            color: #6c757d;
            margin: 0;
        }

    .hr-divider {
        border: none;
        height: 1px;
        background: linear-gradient(to right, transparent, #dee2e6, transparent);
        margin: 50px 0;
    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .page-header {
            padding: 30px 15px;
        }

            .page-header h1 {
                font-size: 2rem;
            }

        .tutorial-grid {
            grid-template-columns: 1fr;
            gap: 20px;
        }

        .section-header {
            flex-direction: column;
            text-align: center;
            gap: 15px;
        }

            .section-header i {
                margin-right: 0;
            }

        .guide-steps {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 576px) {
        .user-guide-container {
            padding: 20px 0;
        }

        .page-header h1 {
            font-size: 1.7rem;
        }

        .section-header h2 {
            font-size: 1.5rem;
        }

        .card-body {
            padding: 20px;
        }

        .btn-tutorial {
            padding: 10px 20px;
            font-size: 0.9rem;
        }
    }
</style>

<div class="user-guide-container">
    <div class="container">
        <!-- Page Header -->
