                        </div>
                    </div>
                </div>
                
                <!-- Video 3 -->
                <div class="tutorial-card">
                    <div class="card-header">
                        <h3>ShareIT - Video 3</h3>
                    </div>
                    <div class="card-body">
                        <div class="video-play-overlay">
                            <img src="~/Video/WB/whBlo.png" alt="ShareIT Video 3" class="tutorial-image" />
                        </div>
                        <p class="tutorial-description">
